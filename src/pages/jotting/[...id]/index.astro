---
import { getCollection, render } from "astro:content";
import Time from "$lib/time";
import Base from "$layouts/Base.astro";
import Position from "$components/Position.astro";
import Icon from "$components/Icon.svelte";
import Sensitive from "$components/Sensitive.svelte";

export async function getStaticPaths() {
	const jottings = await getCollection("jotting", jotting => !jotting.data.draft);
	return jottings.map(jotting => ({ params: { id: jotting.id }, props: { jotting } }));
}

const { jotting } = Astro.props;
const { Content, remarkPluginFrontmatter: frontmatter } = await render(jotting);
---

<Base title={jotting.data.title} description={jotting.data.description} article={{ timestamp: jotting.data.timestamp, tags: jotting.data.tags }}>
	<main class="flex flex-col gap-6">
		<header class="flex flex-col gap-4">
			<h1 class="select-text">{jotting.data.title}</h1>
			<div class="flex flex-col gap-3 sm:flex-row *:flex *:items-center *:gap-1 *:text-[0.875rem] *:text-secondary">
				<time datetime={jotting.data.timestamp.toISOString()}><Icon name="lucide--calendar" />{Time.toString(jotting.data.timestamp)}</time>
				{
					!!jotting.data.tags?.length && (
						<span>
							<Icon name="lucide--hash" />
							{jotting.data.tags?.join("; ")}
						</span>
					)
				}
				<span><Icon name="lucide--pilcrow" />{frontmatter.words} {frontmatter.words === 1 ? "word" : "words"}</span>
			</div>
			<hr class="border-b border-weak" />
		</header>

		<Sensitive back="/jotting" sensitive={jotting.data.sensitive} client:load>
			<section id="markdown-content" class="markdown"><Content /></section>
		</Sensitive>

		<Position />
	</main>
</Base>
