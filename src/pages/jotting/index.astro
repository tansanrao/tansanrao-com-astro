---
import { getCollection } from "astro:content";
import Base from "$layouts/Base.astro";
import Jotting from "$components/Jotting.svelte";

const jottings = await getCollection("jotting", jotting => !jotting.data.draft);

const list = jottings.map(jotting => ({
	id: jotting.id,
	url: `/jotting/${jotting.id}`,
	data: {
		title: jotting.data.title,
		timestamp: jotting.data.timestamp,
		tags: jotting.data.tags,
		sensitive: jotting.data.sensitive,
		top: jotting.data.top
	}
}));

const tags = Array.from(new Set(jottings.flatMap(jotting => jotting.data.tags).filter((tag): tag is string => Boolean(tag)))).sort();
---

<Base title="Jotting">
	<main class="flex flex-col grow">
		<Jotting client:load jottings={list} {tags} />
	</main>
</Base>
