---
import { getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "$layouts/Base.astro";
import profile from "../images/profile.jpg";

const introduction = await getEntry("information", "introduction");
const linkroll = await getEntry("information", "linkroll");

const { Content: Introduction } = introduction ? await render(introduction) : ({} as any);
const { Content: Linkroll } = linkroll ? await render(linkroll) : ({} as any);
---

<Base title="About">
	<main class="flex flex-col gap-8">
		<h1 class="sr-only">About</h1>
		<article class="flex flex-col gap-8">
			{
				introduction && (
					<div class="flex flex-col items-center gap-6 md:flex-row md:items-start md:gap-8">
						<div class="w-full max-w-56 shrink-0 md:max-w-72">
							<Image
								src={profile}
								alt="Portrait of Tanuj Ravi Rao"
								width={1835}
								height={1835}
								class="w-full rounded-2xl object-cover shadow-sm"
							/>
						</div>

						<div class="min-w-0 flex-1">
							<h2 class="mb-4">Introduction</h2>
							<div class="markdown">
								<Introduction />
							</div>
						</div>
					</div>
				)
			}
			{
				linkroll && (
					<div>
						<h2 class="mb-4">Linkroll</h2>
						<div class="markdown">
							<Linkroll />
						</div>
					</div>
				)
			}
		</article>
	</main>
</Base>
