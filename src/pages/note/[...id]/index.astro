---
import { getCollection, render } from "astro:content";
import Time from "$lib/time";
import Base from "$layouts/Base.astro";
import TOC from "$components/TOC.astro";
import Position from "$components/Position.astro";
import Icon from "$components/Icon.svelte";
import Sensitive from "$components/Sensitive.svelte";

export async function getStaticPaths() {
	const notes = await getCollection("note", note => !note.data.draft);
	return notes.map(note => ({ params: { id: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content, headings, remarkPluginFrontmatter: frontmatter } = await render(note);

const series = note.data.series
	? (await getCollection("note", item => !item.data.draft && item.data.series === note.data.series))
			.sort((a, b) => a.data.timestamp.getTime() - b.data.timestamp.getTime())
			.map(item => ({
				title: item.data.title,
				url: `/note/${item.id}`,
				current: item.id === note.id
			}))
	: undefined;
---

<Base title={note.data.title} description={note.data.description} article={{ timestamp: note.data.timestamp, section: note.data.series, tags: note.data.tags }}>
	<main class="flex flex-col gap-6">
		<header class="flex flex-col gap-4">
			<h1 class="select-text">{note.data.title}</h1>
			<div class="flex flex-col gap-3 sm:flex-row *:flex *:items-center *:gap-1 *:text-[0.875rem] *:text-secondary">
				<time datetime={note.data.timestamp.toISOString()}><Icon name="lucide--calendar" />{Time.toString(note.data.timestamp)}</time>
				{
					note.data.series && (
						<span>
							<Icon name="lucide--layers" />
							{note.data.series}
						</span>
					)
				}
				{
					!!note.data.tags?.length && (
						<span>
							<Icon name="lucide--hash" />
							{note.data.tags?.join("; ")}
						</span>
					)
				}
				<span><Icon name="lucide--pilcrow" />{frontmatter.words} {frontmatter.words === 1 ? "word" : "words"}</span>
			</div>
			<hr class="border-b border-weak" />
		</header>

		<Sensitive back="/note" sensitive={note.data.sensitive} client:load>
			<div class="contents">
				<div class="flex gap-5">
					<section id="markdown-content" class="markdown"><Content /></section>
					{(note.data.toc || !!note.data.series) && <TOC headings={note.data.toc ? headings : undefined} {series} />}
				</div>
			</div>
		</Sensitive>

		<Position toc={note.data.toc} series={!!note.data.series} />
	</main>
</Base>
