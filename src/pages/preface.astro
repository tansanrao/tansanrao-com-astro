---
import { getCollection, render } from "astro:content";
import Time from "$lib/time";
import Base from "$layouts/Base.astro";

const prefaces = (await getCollection("preface")).sort((a, b) => b.data.timestamp.getTime() - a.data.timestamp.getTime());
const entries = await Promise.all(prefaces.map(async preface => ({ ...preface, content: (await render(preface)).Content })));
---

<Base title="Preface">
	<main class="flex flex-col">
		<h2>Prefaces</h2>
		<ul class="flex flex-col list-none">
			{
				entries.map(preface => [
					<hr class="my-5 border-b border-primary" />,
					<li>
						<time datetime={preface.data.timestamp.toISOString()} class="block mb-5 font-bold text-xl">
							{Time.toLocaleString(preface.data.timestamp, "en")}
						</time>
						<article class="markdown">
							<preface.content />
						</article>
					</li>
				])
			}
		</ul>
	</main>
</Base>
