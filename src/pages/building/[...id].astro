---
import { getCollection, getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "$layouts/Base.astro";
import Prose from "$components/Prose.astro";
import { writingEntryPath } from "$lib/paths";

export async function getStaticPaths() {
	return (await getCollection("projects", entry => !entry.data.draft)).map(entry => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const writing = await Promise.all(
	data.relatedWriting.map(async ref => {
		const article = await getEntry(ref);
		if (!article) throw new Error(`Project ${entry.id}: missing writing ${ref.id}`);
		return article;
	})
);
---

<Base title={data.title} description={data.description}>
	<main class="flex flex-col gap-8 grow">
		<a class="link self-start" href="/building">All projects</a>
		<header class="flex flex-col gap-3">
			<h1>{data.title}</h1><p>{data.description}</p>
			<p class="text-secondary">
				{data.status.replaceAll("-", " ")}{
					data.startedOn && (
						<>
							{" "}
							· <time datetime={data.startedOn}>{data.startedOn}</time>
						</>
					)
				}{
					data.endedOn && (
						<>
							{" "}
							— <time datetime={data.endedOn}>{data.endedOn}</time>
						</>
					)
				}
			</p>
			{data.technologies.length > 0 && <p>{data.technologies.join(" · ")}</p>}
			<div class="flex flex-wrap gap-5">
				{
					data.links.map(link => (
						<a class="link" href={link.url}>
							{link.label}
						</a>
					))
				}
			</div>
		</header>
		{data.cover && <Image src={data.cover.image} alt={data.cover.alt} width={1200} class="w-full h-auto" />}
		<Prose><Content /></Prose>
		{
			writing.some(article => !article.data.draft) && (
				<section>
					<>
						<h2>Related writing</h2>
						<ul class="mt-3 flex flex-col gap-2">
							{writing
								.filter(article => !article.data.draft)
								.map(article => (
									<li>
										<a class="link" href={writingEntryPath(article)}>
											{article.data.title}
										</a>
									</li>
								))}
						</ul>
					</>
				</section>
			)
		}
	</main>
</Base>
