---
import { getCollection, render } from "astro:content";
import { blogEntryPath, blogEntryRestParam } from "$lib/paths";
import Time from "$lib/time";
import Base from "$layouts/Base.astro";
import TOC from "$components/TOC.astro";
import Position from "$components/Position.astro";
import Icon from "$components/Icon.svelte";
import Sensitive from "$components/Sensitive.svelte";
import MarkdownAlert from "$components/MarkdownAlert.astro";
import { isOlderThanYears } from "$lib/content-age";
import { getReadingStats } from "$lib/reading";

export async function getStaticPaths() {
	const entries = await getCollection("blog", entry => !entry.data.draft);
	return entries.map(entry => ({ params: { id: blogEntryRestParam(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { words } = getReadingStats(entry.body);
const authorNames = entry.data.authors.map(author => author.name);
const showArchiveNotice = isOlderThanYears(entry.data.timestamp, 2);
const hasSupplementaryNavigation = entry.data.toc || !!entry.data.series;

const series = entry.data.series
	? (await getCollection("blog", item => !item.data.draft && item.data.series === entry.data.series))
			.sort((a, b) => a.data.timestamp.getTime() - b.data.timestamp.getTime())
			.map(item => ({
				title: item.data.title,
				url: blogEntryPath(item),
				current: item.id === entry.id
			}))
	: undefined;
---

<style>
	.blog-reading-layout {
		width: 100%;
		max-inline-size: 72ch;
		margin-inline: auto;
	}

	@media (min-width: 1024px) {
		.blog-reading-layout.has-supplementary-navigation {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 12.5rem;
			gap: 1.25rem;
			max-inline-size: calc(72ch + 13.75rem);
		}
	}
</style>

<Base
	title={entry.data.title}
	description={entry.data.description}
	canonicalURL={entry.data.canonicalURL}
	noindex={entry.data.syndicated}
	article={{
		timestamp: entry.data.timestamp,
		updatedTimestamp: entry.data.updatedTimestamp,
		section: entry.data.series,
		tags: entry.data.tags,
		authors: authorNames
	}}
>
	<main class="flex flex-col gap-6">
		<header class="flex flex-col gap-4">
			<h1 class="select-text">{entry.data.title}</h1>
			<div class="flex flex-wrap gap-x-4 gap-y-2 text-[0.875rem] text-secondary">
				<span class="flex items-center gap-1">
					<Icon name="lucide--user-round" />
					<span class="flex flex-wrap items-center gap-1">
						{entry.data.authors.map((author, index) => (
							<>
								{author.url ? (
									<a href={author.url} target="_blank" rel="noopener noreferrer" class="link">
										{author.name}
									</a>
								) : (
									<span>{author.name}</span>
								)}
								{index < entry.data.authors.length - 1 && <span aria-hidden="true">,</span>}
							</>
						))}
					</span>
				</span>
				<div class="flex flex-wrap gap-x-4 gap-y-2 *:flex *:items-center *:gap-1">
					<time datetime={entry.data.timestamp.toISOString()}><Icon name="lucide--calendar" />{Time.toString(entry.data.timestamp)}</time>
					{
						entry.data.updatedTimestamp && (
							<time datetime={entry.data.updatedTimestamp.toISOString()}>
								<Icon name="lucide--refresh-cw" />
								Updated {Time.toString(entry.data.updatedTimestamp)}
							</time>
						)
					}
					{
						entry.data.series && (
							<span>
								<Icon name="lucide--layers" />
								{entry.data.series}
							</span>
						)
					}
					{
						!!entry.data.tags?.length && (
							<span>
								<Icon name="lucide--hash" />
								{entry.data.tags?.join("; ")}
							</span>
						)
					}
					<span><Icon name="lucide--pilcrow" />{words} {words === 1 ? "word" : "words"}</span>
				</div>
			</div>
			<hr class="border-b border-weak" />
		</header>

		<Sensitive back="/blog" sensitive={entry.data.sensitive} client:load>
			<div class="contents">
				<div class:list={["blog-reading-layout", { "has-supplementary-navigation": hasSupplementaryNavigation }]}>
					<section id="markdown-content" class="markdown min-w-0">
						{
							showArchiveNotice && (
								<MarkdownAlert>
									<p>This post is over 2 years old and the information contained could be outdated or now irrelevant.</p>
								</MarkdownAlert>
							)
						}
						<Content />
					</section>
					{hasSupplementaryNavigation && <TOC headings={entry.data.toc ? headings : undefined} {series} inlineFrom="lg" />}
				</div>
			</div>
		</Sensitive>

		<Position toc={entry.data.toc} series={!!entry.data.series} inlineFrom="lg" />
	</main>
</Base>
