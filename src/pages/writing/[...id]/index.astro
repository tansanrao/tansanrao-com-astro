---
import { getCollection, render } from "astro:content";
import { writingEntryPath, writingEntryRestParam } from "$lib/paths";
import Base from "$layouts/Base.astro";
import ReadingLayout from "$layouts/ReadingLayout.astro";
import ArticleHeader from "$components/ArticleHeader.astro";
import TOC from "$components/TOC.astro";
import Position from "$components/Position.astro";
import Sensitive from "$components/Sensitive.astro";
import MarkdownAlert from "$components/MarkdownAlert.astro";
import Prose from "$components/Prose.astro";
import { isOlderThanYears } from "$lib/content-age";
import { getReadingStats } from "$lib/reading";

export async function getStaticPaths() {
	const entries = await getCollection("writing", entry => !entry.data.draft);
	return entries.map(entry => ({ params: { id: writingEntryRestParam(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { words } = getReadingStats(entry.body);
const authorNames = entry.data.authors.map(author => author.name);
const showArchiveNotice = isOlderThanYears(entry.data.publishedAt, 2);
const hasSupplementaryNavigation = entry.data.toc || !!entry.data.series;

const series = entry.data.series
	? (await getCollection("writing", item => !item.data.draft && item.data.series === entry.data.series))
			.sort((a, b) => a.data.publishedAt.getTime() - b.data.publishedAt.getTime())
			.map(item => ({
				title: item.data.title,
				url: writingEntryPath(item),
				current: item.id === entry.id
			}))
	: undefined;
---

<Base
	title={entry.data.title}
	description={entry.data.description}
	canonicalURL={entry.data.canonicalURL}
	noindex={entry.data.syndicated}
	article={{
		publishedAt: entry.data.publishedAt,
		updatedAt: entry.data.updatedAt,
		section: entry.data.series,
		tags: entry.data.tags,
		authors: authorNames
	}}
>
	<ReadingLayout sidebar={hasSupplementaryNavigation}>
		<ArticleHeader
			slot="header"
			title={entry.data.title}
			authors={entry.data.authors}
			publishedAt={entry.data.publishedAt}
			updatedAt={entry.data.updatedAt}
			series={entry.data.series}
			tags={entry.data.tags}
			{words}
		/>

		<Sensitive back="/writing" sensitive={entry.data.sensitive}>
			<div class="contents">
				<div data-reading-body>
					<Prose as="section" id="markdown-content" class="min-w-0">
						{
							showArchiveNotice && (
								<MarkdownAlert>
									<p>This post is over 2 years old and the information contained could be outdated or now irrelevant.</p>
								</MarkdownAlert>
							)
						}
						<Content />
					</Prose>
					{hasSupplementaryNavigation && <TOC headings={entry.data.toc ? headings : undefined} {series} inlineFrom="reader" />}
				</div>
			</div>
		</Sensitive>

		<Position slot="controls" toc={entry.data.toc} series={!!entry.data.series} inlineFrom="reader" />
	</ReadingLayout>
</Base>
