---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { writingEntryPath } from "$lib/paths";
import { getPhotography, photoPath } from "$lib/photography";
import Time from "$lib/time";
import Base from "$layouts/Base.astro";
import Icon from "$components/Icon.astro";
import HomeArtwork from "$components/HomeArtwork.astro";

const [allWriting, allProjects, photography, allNotes, allBooks, allLinks] = await Promise.all([
	getCollection("writing", entry => !entry.data.draft),
	getCollection("projects", entry => !entry.data.draft),
	getPhotography(),
	getCollection("notes", entry => !entry.data.draft),
	getCollection("books", entry => !entry.data.draft),
	getCollection("links", entry => !entry.data.draft)
]);
const writing = allWriting.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()).slice(0, 3);
const projects = allProjects.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()).slice(0, 2);
const photos = photography.photos.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()).slice(0, 3);
const notes = allNotes
	.sort((a, b) => (b.data.updatedAt ?? b.data.publishedAt).getTime() - (a.data.updatedAt ?? a.data.publishedAt).getTime())
	.slice(0, 3);
const books = allBooks.sort((a, b) => b.data.addedAt.getTime() - a.data.addedAt.getTime()).slice(0, 3);
const links = allLinks.sort((a, b) => b.data.savedAt.getTime() - a.data.savedAt.getTime() || a.data.title.localeCompare(b.data.title)).slice(0, 3);
const bookStatus = { "to-read": "To read", reading: "Reading", read: "Read", paused: "Paused", abandoned: "Abandoned" };
const projectStatus = { "in-progress": "In progress", maintained: "Maintained", completed: "Completed", archived: "Archived" };
const garden = [
	{
		title: "Notes",
		href: "/garden/notes",
		artwork: "notes" as const,
		placeholder: "Note",
		entries: notes.map(entry => ({
			title: entry.data.title,
			href: `/garden/notes/${entry.id}`,
			detail: `Updated ${Time.toLocaleDateString(entry.data.updatedAt ?? entry.data.publishedAt, "en-US")}`
		}))
	},
	{
		title: "Reading",
		href: "/garden/books",
		artwork: "books" as const,
		placeholder: "Book",
		entries: books.map(entry => ({ title: entry.data.title, href: `/garden/books/${entry.id}`, detail: bookStatus[entry.data.status] }))
	},
	{
		title: "Links",
		href: "/garden/links",
		artwork: "links" as const,
		placeholder: "Link",
		entries: links.map(entry => ({
			title: entry.data.title,
			href: `/garden/links#${entry.id}`,
			detail: new URL(entry.data.url).hostname.replace(/^www\./, "")
		}))
	}
];
// These non-linked previews come from the design reference, not published projects.
const projectPreviews = [
	{ title: "Nexus KB", description: "An exploratory workspace for Linux kernel mailing lists.", artwork: "project" as const },
	{ title: "PDF reader for iPad", description: "A reading app I’m building.", artwork: "tablet" as const }
];
---

<Base title="Home">
	<main class="homepage">
		<header class="intro">
			<div>
				<h1>Hi, I’m Tanuj.</h1>
				<p class="intro-lead">I'm an engineer turned researcher working on accelerating dataplanes through kernel extensions.</p>
			</div>
			<div class="intro-aside">
				<p>
                I’m a PhD student at Virginia Tech, a software engineer, and a homelab tinkerer. I’m also drawn to graphic design, thoughtful interfaces, and photography. This website is my little corner of the internet that brings those parts of me together—a place to share what I’m building, noticing, and learning as I go.
                </p>
				<a class="section-link" href="/about">More about me &amp; CV <Icon name="lucide--arrow-right" size="var(--icon-size)" /></a>
			</div>
		</header>

		<section aria-labelledby="home-writing">
			<div class="section-heading"><h2 id="home-writing">Writing</h2><a class="section-link" href="/writing">All writing <Icon name="lucide--arrow-right" size="var(--icon-size)" /></a></div>
			<ul class="writing-list">
				{writing.map(entry => <li><a href={writingEntryPath(entry)} class="writing-row">
					<time datetime={entry.data.publishedAt.toISOString()}>{Time.toLocaleDateString(entry.data.publishedAt, "en-US")}</time>
					<span>{entry.data.title}</span><Icon name="lucide--arrow-right" size="var(--icon-size)" />
				</a></li>)}
			</ul>
			{writing.length === 0 && <p class="empty-message">New writing is on its way.</p>}
		</section>

		<section aria-labelledby="home-building">
			<div class="section-heading"><h2 id="home-building">Building</h2><a class="section-link" href="/building">All projects <Icon name="lucide--arrow-right" size="var(--icon-size)" /></a></div>
			<div class="project-grid">
				{projects.map(({ id, data }) => <a href={`/building/${id}`} class="project-card">
					<div class="project-art">{data.cover ? <Image src={data.cover.image} alt={data.cover.alt} width={440} loading="lazy" /> : <HomeArtwork kind="project" />}</div>
					<div class="project-copy"><h3>{data.title}</h3><p>{data.description}</p><span class="status">{projectStatus[data.status]}</span></div>
				</a>)}
				{projects.length === 0 && projectPreviews.map(project => <article class="project-card" data-placeholder>
					<div class="project-art"><HomeArtwork kind={project.artwork} /></div>
					<div class="project-copy"><h3>{project.title}</h3><p>{project.description}</p><span class="status">Layout preview</span></div>
				</article>)}
			</div>
		</section>

		<section aria-labelledby="home-photography">
			<div class="section-heading"><h2 id="home-photography">Photography</h2><a class="section-link" href="/photography">All photographs <Icon name="lucide--arrow-right" size="var(--icon-size)" /></a></div>
			<div class="photo-grid">
				{photos.map(({ id, data }) => {
					const collection = photography.collections.find(collection => collection.data.entries.some(item => item.photo.id === id));
					const item = collection?.data.entries.find(item => item.photo.id === id);
					const href = collection && item ? photoPath(collection, item) : `/photography/photos/${id}`;
					const label = `${collection?.data.title ?? "Photos"} | ${item?.slug ?? item?.day ?? id.split("/").at(-1)}`;
					return <figure style={{ "--photo-aspect-ratio": data.image.width / data.image.height }}>
					<a class="photo-frame" href={href}><Image src={data.image} alt={data.alt} width={800} sizes="(max-width: 639px) 100vw, 45vw" loading="lazy" format="webp" /></a>
					<figcaption><a href={href}>{label}</a></figcaption>
				</figure>})}
				{photos.length === 0 && (["landscape", "architecture", "botanical"] as const).map(kind => <figure data-placeholder>
					<div class="photo-frame"><HomeArtwork kind={kind} /></div>
					<figcaption>Photo placeholder<span>Caption / location</span></figcaption>
				</figure>)}
			</div>
		</section>

		<section aria-labelledby="home-garden">
			<div class="section-heading"><h2 id="home-garden">Garden</h2><a class="section-link" href="/garden">Visit the garden <Icon name="lucide--arrow-right" size="var(--icon-size)" /></a></div>
			{garden.some(group => group.entries.length === 0) && <p class="preview-note">Placeholder rows are shown where there’s no published content yet.</p>}
			<div class="garden-groups">
				{garden.map(group => <section class="garden-group" aria-label={group.title}>
					<a class="garden-label" href={group.href}><span class="garden-art"><HomeArtwork kind={group.artwork} /></span><h3>{group.title}</h3></a>
					<ul class="garden-list">
						{group.entries.map(entry => <li><a href={entry.href} class="garden-row"><span>{entry.title}</span><span class="entry-detail">{entry.detail}</span><Icon name="lucide--arrow-right" size="var(--icon-size)" /></a></li>)}
						{group.entries.length === 0 && [1, 2, 3].map(number => <li class="garden-row placeholder-row" data-placeholder><span>{group.placeholder} preview {String(number).padStart(2, "0")}</span><span class="entry-detail">Coming soon</span><span aria-hidden="true">—</span></li>)}
					</ul>
				</section>)}
			</div>
		</section>
	</main>
</Base>

<style>
	@reference "../styles/global.css";

	.homepage { display: flex; flex-direction: column; gap: var(--section-gap); overflow-wrap: anywhere; }
	.intro {
		display: grid; align-items: start; gap: var(--grid-gap);
		@variant md { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: var(--space-12); }
	}
	h1 { font: var(--type-display); margin-bottom: var(--space-4); }
	.intro-lead { font: var(--type-lead); text-wrap: balance; }
	.intro-aside { display: flex; flex-direction: column; gap: var(--space-4); color: var(--secondary-color); }
	.section-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2) var(--space-4); margin-bottom: var(--space-4); }
	h2 { font: var(--type-section); }
	.section-link { display: inline-flex; align-items: center; gap: var(--space-2); min-height: var(--control-size); color: var(--accent-color); font: var(--type-label); text-decoration: underline; text-underline-offset: var(--link-offset); }
	.section-link :global(figure), .writing-row :global(figure), .garden-row :global(figure) { flex-shrink: 0; }
	.writing-list, .garden-list { list-style: none; padding: 0; margin: 0; }
	.writing-list li + li, .garden-list li + li { border-top: var(--border-width) solid var(--shadow-color); }
	.writing-row, .garden-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: var(--space-1) var(--space-4); padding: var(--row-padding) 0; min-height: var(--control-size); }
	.writing-row time, .entry-detail { font: var(--type-meta); color: var(--secondary-color); }
	.writing-row > span { grid-row: 2; }
	.writing-row :global(figure), .garden-row :global(figure), .placeholder-row > span:last-child { grid-column: 2; grid-row: 1 / 3; }
	.garden-row .entry-detail { grid-row: 2; }
	.writing-row :global(figure), .garden-row :global(figure) { color: var(--secondary-color); align-self: center; }
	.writing-row { @variant sm { grid-template-columns: var(--label-width) minmax(0, 1fr) auto; gap: var(--grid-gap); } }
	.writing-row > span, .writing-row :global(figure) { @variant sm { grid-row: auto; grid-column: auto; } }
	.garden-row { @variant lg { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) auto; gap: var(--space-4); } }
	.garden-row .entry-detail, .garden-row :global(figure), .placeholder-row > span:last-child { @variant lg { grid-row: auto; grid-column: auto; } }
	.writing-row:hover, .garden-row[href]:hover, .garden-label:hover, figcaption a:hover { color: var(--accent-color); }
	.project-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--card-min-width)), 1fr)); gap: var(--grid-gap); }
	.project-card { display: flex; flex-wrap: wrap; align-items: flex-start; gap: var(--space-4); border: var(--border-width) solid var(--shadow-color); border-radius: var(--radius-card); padding: var(--card-padding); min-width: 0; }
	.project-card[href]:hover { border-color: var(--accent-color); }
	.project-art { flex: 1 1 var(--illustration-size); height: var(--illustration-size); align-self: center; }
	.project-art :global(img) { width: 100%; height: 100%; object-fit: contain; }
	.project-copy { display: flex; flex: 2 1 var(--label-width); flex-direction: column; align-items: flex-start; gap: var(--space-2); min-width: 0; }
	.project-copy h3, .garden-label h3 { font: var(--type-item); }
	.project-copy p, .status, figcaption, .preview-note, .empty-message { color: var(--secondary-color); }
	.status { font: var(--type-meta); padding: var(--space-1) var(--space-3); border-radius: var(--radius-pill); background: var(--shadow-color); margin-top: var(--space-2); }
	.photo-grid {
		display: flex; flex-wrap: wrap; align-items: flex-start; gap: var(--grid-gap);
	}
	.photo-grid > figure {
		min-width: 0; width: 100%; max-width: 100%;
		@variant sm {
			width: calc(var(--media-preview-height) * var(--photo-aspect-ratio, 1.5));
		}
	}
	.photo-frame { display: block; background: var(--block-color); }
	[data-placeholder] .photo-frame { aspect-ratio: 3 / 2; }
	.photo-frame :global(img) { display: block; width: 100%; height: auto; }
	figcaption { display: flex; flex-direction: column; gap: var(--space-1); margin-top: var(--space-2); font: var(--type-caption); }
	.preview-note { font: var(--type-meta); margin-bottom: var(--space-6); }
	.garden-groups { display: flex; flex-direction: column; gap: var(--space-8); }
	.garden-group { display: flex; flex-wrap: wrap; align-items: flex-start; gap: var(--grid-gap); }
	.garden-list { flex: 1 1 var(--card-min-width); min-width: 0; }
	.garden-label {
		display: flex; flex-wrap: wrap; flex: 0 1 100%; align-items: center; gap: var(--space-4); min-height: var(--control-size); min-width: 0;
		@variant sm { flex-basis: var(--label-width); flex-direction: column; align-items: flex-start; gap: var(--space-2); }
	}
	.garden-art { display: block; width: min(100%, var(--illustration-size)); aspect-ratio: 3 / 2; }
	.placeholder-row { color: var(--secondary-color); }
</style>
