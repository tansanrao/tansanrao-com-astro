---
import { getCollection } from "astro:content";
import { writingEntryPath } from "$lib/paths";
import config from "$config";
import Time from "$lib/time";
import Base from "$layouts/Base.astro";
import Heatmap from "$components/Heatmap.astro";
import NewsList from "$components/NewsList.astro";
import Logo from "$icons/site-logo.svg";

const news = (await getCollection("news")).sort((a, b) => b.data.timestamp.getTime() - a.data.timestamp.getTime());
const writingEntries = await getCollection("writing", entry => !entry.data.draft);
const notes = await getCollection("notes", entry => !entry.data.draft);
const latestNews = news.slice(0, 3);

let items: { id: string; type?: string; data: { publishedAt: Date; tags?: string[]; [key: string]: any } }[] = [];
const sections = config.latest || "*";

writingEntries.forEach(entry => {
	Reflect.set(entry, "type", "writing");
	Reflect.set(entry, "url", writingEntryPath(entry));
});
notes.forEach(entry => {
	Reflect.set(entry, "type", "notes");
	Reflect.set(entry, "url", `/garden/notes/${entry.id}`);
});

if (sections === "*" || sections.includes("writing")) items = items.concat(writingEntries);
if (sections === "*" || sections.includes("notes")) items = items.concat(notes);

const latest = items.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())[0];
---

<Base title="Home">
	<main class="flex flex-col gap-5 sm:gap-20 grow">
		<h1 class="sr-only">{config.title}</h1>
		<header class="flex flex-col justify-center gap-6 md:gap-8 grow-[0.6]">
			<div class="self-center">
				<Logo width={100} />
			</div>
			{config.prologue && <article class="select-text text-md sm:text-xl leading-loose whitespace-pre-line italic">{config.prologue}</article>}
		</header>

		{
			latestNews.length > 0 && (
				<section class="flex flex-col gap-4">
					<div class="flex items-end justify-between gap-3">
						<h2>
							<a href="/news" class="link">Latest News</a>
						</h2>
						<a href="/news" class="text-sm text-secondary link">Archive</a>
					</div>

					<NewsList entries={latestNews} />
				</section>
			)
		}

		{
			latest && (
				<footer class="flex items-center justify-center flex-wrap-reverse gap-10">
					<Heatmap writingEntries={writingEntries} {notes} />

					<blockquote class="grow flex flex-col">
						<h4>Latest</h4>
						<div class="flex flex-col sm:flex-row justify-between gap-1 mt-1">
							<a href={(latest as any).url} class="link">
								{latest.data.series && `${latest.data.series} | `}
								{latest.data.title}
							</a>
							<div class="flex gap-1">
								{latest.data.tags?.map(tag => (
									<a href={`${latest.type === "notes" ? "/garden/notes" : "/writing"}?tag=${encodeURIComponent(tag)}`} class="text-remark text-sm link">#{tag}</a>
								))}
							</div>
						</div>
						<time datetime={latest.data.publishedAt.toISOString()} title={Time.toString(latest.data.publishedAt)} class="text-remark font-mono text-xs">
							{Time.toString(latest.data.publishedAt)}
						</time>
					</blockquote>
				</footer>
			)
		}
	</main>
</Base>
