---
import PhotoDetail from "$components/PhotoDetail.astro";
import { getPhotography } from "$lib/photography";

export async function getStaticPaths() {
	const { uncollected } = await getPhotography();
	return uncollected.map(entry => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---

<PhotoDetail {entry} />
