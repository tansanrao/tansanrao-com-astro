---
import { render } from "astro:content";
import { Image } from "astro:assets";
import Base from "$layouts/Base.astro";
import Prose from "$components/Prose.astro";
import { getPhotography, photoCollectionPath } from "$lib/photography";

export async function getStaticPaths() {
	const { photos } = await getPhotography();
	return photos.map(entry => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const { photos, collections, equipmentById } = await getPhotography();
const memberships = collections.filter(collection => collection.data.entries.some(item => item.photo.id === entry.id));
const ordered = photos.sort(
	(a, b) =>
		(a.data.takenOn ?? a.data.publishedAt.toISOString()).localeCompare(b.data.takenOn ?? b.data.publishedAt.toISOString()) ||
		a.id.localeCompare(b.id)
);
const index = ordered.findIndex(photo => photo.id === entry.id);
const previous = ordered[index - 1];
const next = ordered[index + 1];
const title = data.title ?? (data.takenOn ? `Photo from ${data.takenOn}` : "Photograph");
const settings = data.settings;
const exposure = settings?.exposureSeconds;
const shutter = exposure && exposure < 1 && Math.abs(1 / exposure - Math.round(1 / exposure)) < 0.01 ? `1/${Math.round(1 / exposure)}` : exposure;
---

<Base {title} description={data.alt}>
	<main class="flex flex-col gap-8 grow">
		<a class="link self-start" href="/photography">Photography</a>
		<h1>{title}</h1>
		<Image src={data.image} alt={data.alt} width={Math.min(1600, data.image.width)} widths={[640, 960, 1600].filter(width => width <= data.image.width)} sizes="(max-width: 1100px) 100vw, 1100px" format="webp" loading="eager" class="w-full h-auto max-h-[75vh] object-contain" />
		<nav aria-label="Photos" class="flex justify-between gap-5">
			{
				previous ? (
					<a class="link" rel="prev" href={`/photography/photos/${previous.id}`}>
						Previous photo
					</a>
				) : (
					<span />
				)
			}
			{
				next && (
					<a class="link" rel="next" href={`/photography/photos/${next.id}`}>
						Next photo
					</a>
				)
			}
		</nav>
		<dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-3">
			<dt>Date</dt><dd>{data.takenOn ? <time datetime={data.takenAt ?? data.takenOn}>{data.takenOn}</time> : "Unknown"}</dd>
			{
				(["camera", "lens", "film"] as const).map(kind => {
					const ref = data[kind];
					const item = ref ? equipmentById.get(ref.id) : undefined;
					return (
						item && (
							<>
								<>
									<dt class="capitalize">{kind}</dt>
									<dd>
										{item.data.url ? (
											<a class="link" href={item.data.url}>
												{item.data.name}
											</a>
										) : (
											item.data.name
										)}
									</dd>
								</>
							</>
						)
					);
				})
			}
			{
				settings?.focalLengthMm && (
					<>
						<>
							<dt>Focal length</dt>
							<dd>{settings.focalLengthMm}mm</dd>
						</>
					</>
				)
			}
			{
				settings?.aperture && (
					<>
						<>
							<dt>Aperture</dt>
							<dd>ƒ/{settings.aperture}</dd>
						</>
					</>
				)
			}
			{
				exposure && (
					<>
						<>
							<dt>Shutter speed</dt>
							<dd>{shutter}s</dd>
						</>
					</>
				)
			}
			{
				settings?.iso && (
					<>
						<>
							<dt>ISO</dt>
							<dd>{settings.iso}</dd>
						</>
					</>
				)
			}
			{
				settings?.exposureCompensationEv !== undefined && (
					<>
						<>
							<dt>Exposure compensation</dt>
							<dd>{settings.exposureCompensationEv} EV</dd>
						</>
					</>
				)
			}
			{
				data.location && (
					<>
						<>
							<dt>Location</dt>
							<dd>{data.location}</dd>
						</>
					</>
				)
			}
			{
				memberships.length > 0 && (
					<>
						<>
							<dt>Collections</dt>
							<dd class="flex flex-wrap gap-4">
								{memberships.map(collection => (
									<a class="link" href={photoCollectionPath(collection.id)}>
										{collection.data.title}
									</a>
								))}
							</dd>
						</>
					</>
				)
			}
		</dl>
		<Prose><Content /></Prose>
	</main>
</Base>
