---
import { Image } from "astro:assets";
import Base from "$layouts/Base.astro";
import { getPhotography, photoCollectionPath } from "$lib/photography";
import "$styles/photography.css";

const { collections, photoById } = await getPhotography();
---

<Base title="Photography" description="One photo a day, and collections from along the way.">
	<main class="photography-page">
		<h1>Photography</h1>
		{collections.length === 0 && <p class="photo-meta">No photo collections published yet.</p>}
		<div>
			{
				collections.map(collection => {
					const cover = photoById.get(collection.data.cover?.id ?? collection.data.entries[0]?.photo.id);
					const count = collection.data.entries.length;
					return (
						<article class="photo-collection">
							{cover && (
								<a class="collection-cover" href={photoCollectionPath(collection.id)} aria-label={`View ${collection.data.title}`}>
									<Image src={cover.data.image} alt={cover.data.alt} width={960} widths={[480, 960, 1600]} sizes="(min-width: 900px) 800px, 100vw" format="webp" />
								</a>
							)}
							<div class="photo-copy">
								<h2>
									<a href={photoCollectionPath(collection.id)}>{collection.data.title}</a>
								</h2>
								{collection.data.description && <p>{collection.data.description}</p>}
								<p class="photo-meta">
									{count}
									{collection.data.challenge ? ` / ${collection.data.challenge.days} photos` : ` ${count === 1 ? "photo" : "photos"}`}
								</p>
								<a class="photo-action" href={photoCollectionPath(collection.id)}>
									View {collection.data.kind === "daily" ? "project" : "collection"} →
								</a>
							</div>
						</article>
					);
				})
			}
		</div>
	</main>
</Base>
