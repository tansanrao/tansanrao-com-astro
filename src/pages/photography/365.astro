---
import Base from "$layouts/Base.astro";
import PhotoCollection from "$components/PhotoCollection.astro";
import { getPhotography } from "$lib/photography";

const { collections } = await getPhotography();
const entry = collections.find(collection => collection.id === "365");
---

<Base title={entry?.data.title ?? "365 — one photo a day"} description={entry?.data.description}>
	<PhotoCollection {entry} />
</Base>
