---
import { getEntry, render } from "astro:content";
import Base from "$layouts/Base.astro";

const policy = await getEntry("information", "policy");
const { Content } = policy ? await render(policy) : ({} as any);
---

<Base title="Policy">
	<main>
		<h1 class="sr-only">Policy</h1>
		{
			policy && (
				<div class="markdown">
					<Content />
				</div>
			)
		}
	</main>
</Base>
