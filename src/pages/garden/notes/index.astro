---
import { getCollection } from "astro:content";
import Base from "$layouts/Base.astro";
import GardenLayout from "$layouts/GardenLayout.astro";
import GardenIndex from "$components/GardenIndex.astro";
import NoteCard from "$components/NoteCard.astro";
import config from "$config";

const notes = (await getCollection("notes", entry => !entry.data.draft)).sort(
	(a, b) => b.data.top - a.data.top || (b.data.updatedAt ?? b.data.publishedAt).getTime() - (a.data.updatedAt ?? a.data.publishedAt).getTime()
);
const tags = [...new Set(notes.flatMap(entry => entry.data.tags))].sort();
---

<Base title="Notes">
	<GardenLayout title="Notes">
		<GardenIndex kind="notes" {tags} count={notes.length} size={config.pagination?.notes || 24}>
			{notes.map(entry => <NoteCard {entry} />)}
		</GardenIndex>
	</GardenLayout>
</Base>
