---
import Base from "$layouts/Base.astro";
import GardenNav from "$components/GardenNav.astro";
---

<Base title="Garden" description="Notes, links, and books: a growing collection of things I’m learning and exploring.">
	<main class="flex flex-col gap-8 grow">
		<header class="flex flex-col gap-3">
			<h1>Garden</h1>
			<p class="text-secondary">A growing collection of things I’m learning, reading, and exploring.</p>
		</header>
		<GardenNav />
		<div class="grid gap-8 sm:grid-cols-3">
			<section><h2><a class="link" href="/garden/notes">Notes</a></h2><p class="mt-3">Working ideas, technical notes, and things to return to.</p></section>
			<section><h2><a class="link" href="/garden/links">Links</a></h2><p class="mt-3">Useful resources and people whose work I follow.</p></section>
			<section><h2><a class="link" href="/garden/books">Books</a></h2><p class="mt-3">What I’m reading, with notes and reflections along the way.</p></section>
		</div>
	</main>
</Base>
