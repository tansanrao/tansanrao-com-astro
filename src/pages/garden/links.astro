---
import { getCollection } from "astro:content";
import Base from "$layouts/Base.astro";
import GardenLayout from "$layouts/GardenLayout.astro";
import GardenIndex from "$components/GardenIndex.astro";
import GardenLink from "$components/GardenLink.astro";

const links = (await getCollection("links", entry => !entry.data.draft)).sort(
	(a, b) => b.data.savedAt.getTime() - a.data.savedAt.getTime() || a.data.title.localeCompare(b.data.title)
);
const tags = [...new Set(links.flatMap(entry => entry.data.tags))].sort();
---

<Base title="Links">
	<GardenLayout title="Links">
		<GardenIndex kind="links" {tags} count={links.length}>
			{links.map(entry => <GardenLink {entry} />)}
		</GardenIndex>
	</GardenLayout>
</Base>
