---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "$layouts/Base.astro";
import GardenNav from "$components/GardenNav.astro";
import Prose from "$components/Prose.astro";

export async function getStaticPaths() {
	return (await getCollection("books", entry => !entry.data.draft)).map(entry => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---

<Base title={data.title}>
	<main class="flex flex-col gap-8 grow">
		<GardenNav />
		<header class="flex gap-6 max-sm:flex-col">
			{data.cover && <Image src={data.cover.image} alt={data.cover.alt} width={240} class="w-40 h-auto self-start" />}
			<div class="flex flex-col gap-3">
				<h1>{data.title}</h1><p>{data.authors.join(", ")}</p>
				<p class="text-secondary">{data.status.replaceAll("-", " ")}</p>
				{data.publicationYear && <p>Published {data.publicationYear}</p>}
				{data.isbn && <p>ISBN: {data.isbn}</p>}
				{
					data.url && (
						<a class="link" href={data.url}>
							About this book
						</a>
					)
				}
			</div>
		</header>
		{
			data.readingSessions.length > 0 && (
				<section>
					<>
						<h2>Reading history</h2>
						<ul class="mt-3 flex flex-col gap-2">
							{data.readingSessions.map(session => (
								<li>
									{session.startedOn && (
										<>
											Started <time datetime={session.startedOn}>{session.startedOn}</time>
										</>
									)}
									{session.startedOn && session.finishedOn && " · "}
									{session.finishedOn && (
										<>
											Finished <time datetime={session.finishedOn}>{session.finishedOn}</time>
										</>
									)}
								</li>
							))}
						</ul>
					</>
				</section>
			)
		}
		<Prose><Content /></Prose>
	</main>
</Base>
