---
import { getCollection, render } from "astro:content";
import Base from "$layouts/Base.astro";
import GardenLayout from "$layouts/GardenLayout.astro";
import BookCover from "$components/BookCover.astro";
import Prose from "$components/Prose.astro";
import { bookStatus } from "$lib/books";

export async function getStaticPaths() {
	return (await getCollection("books", entry => !entry.data.draft)).map(entry => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---

<Base title={data.title}>
	<GardenLayout>
		<div class="garden-reader">
			<a class="garden-action" href="/garden/books">← All books</a>
			<header class="book-detail-heading">
				<BookCover book={entry} />
				<div class="book-copy">
					<h1>{data.title}</h1><p>{data.authors.join(", ")}</p>
					<p class="garden-meta">{bookStatus[data.status]}</p>
					{data.pages !== undefined && <p class="garden-meta">{data.pages.toLocaleString("en-US")} pages</p>}
					{data.rating !== undefined && <p class="garden-meta">{data.rating} / 5</p>}
					{data.publicationYear !== undefined && <p class="garden-meta">Published {data.publicationYear}</p>}
					{data.isbn && <p class="garden-meta">ISBN {data.isbn}</p>}
					{data.url && <a class="garden-action" href={data.url} rel="noopener noreferrer">About this book ↗</a>}
				</div>
			</header>
			{data.tags.length > 0 && <p class="garden-meta">{data.tags.map(tag => `#${tag}`).join(" · ")}</p>}
			{entry.body?.trim() && <Prose id="markdown-content" variant="garden"><Content /></Prose>}
			{data.readingSessions.some(session => session.startedOn || session.finishedOn) && <section class="garden-section">
				<h2>Reading history</h2>
				<ul class="book-history">{data.readingSessions.filter(session => session.startedOn || session.finishedOn).map(session => <li>
					{session.startedOn && <span>Started <time datetime={session.startedOn}>{session.startedOn}</time></span>}
					{session.finishedOn && <span>Finished <time datetime={session.finishedOn}>{session.finishedOn}</time></span>}
				</li>)}</ul>
			</section>}
		</div>
	</GardenLayout>
</Base>
