---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "$layouts/Base.astro";
import GardenNav from "$components/GardenNav.astro";

const books = (await getCollection("books", entry => !entry.data.draft)).sort((a, b) => b.data.addedAt.getTime() - a.data.addedAt.getTime());
---

<Base title="Books">
	<main class="flex flex-col gap-8 grow">
		<h1>Books</h1>
		<GardenNav />
		<p class="text-secondary">Books I’m reading, have read, or want to return to.</p>
		{books.length === 0 && <p>No books added yet.</p>}
		<div class="grid gap-8 sm:grid-cols-2">
			{
				books.map(({ id, data }) => (
					<article class="flex gap-5">
						{data.cover && <Image src={data.cover.image} alt={data.cover.alt} width={160} class="w-24 h-auto self-start" />}
						<div class="flex flex-col gap-2">
							<>
								<h2>
									<a class="link" href={`/garden/books/${id}`}>
										{data.title}
									</a>
								</h2>
								<p>{data.authors.join(", ")}</p>
								<p class="text-secondary">{data.status.replaceAll("-", " ")}</p>
							</>
						</div>
					</article>
				))
			}
		</div>
	</main>
</Base>
