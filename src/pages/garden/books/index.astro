---
import { getCollection } from "astro:content";
import Base from "$layouts/Base.astro";
import GardenLayout from "$layouts/GardenLayout.astro";
import BookCard from "$components/BookCard.astro";
import BookShelf from "$components/BookShelf.astro";
import { bookStatus, getBookShelves } from "$lib/books";

const books = (await getCollection("books", entry => !entry.data.draft)).sort((a, b) => b.data.addedAt.getTime() - a.data.addedAt.getTime());
const reading = books.filter(book => book.data.status === "reading");
const shelves = getBookShelves(books);
---

<Base title="Books">
	<GardenLayout title="Books">
		{books.length === 0 && <p class="garden-empty">The shelf is waiting for its first book.</p>}
		{reading.length > 0 && <section class="garden-section" aria-labelledby="reading-now">
			<h2 id="reading-now">Reading now</h2>
			<div class="garden-grid">{reading.map(book => <BookCard {book} />)}</div>
		</section>}
		{shelves.length > 0 && <div class="book-browser">
			<fieldset class="view-options"><legend class="sr-only">Book display</legend><label><input type="radio" name="book-view" value="shelf" checked /> Shelf</label><label><input type="radio" name="book-view" value="list" /> List</label></fieldset>
			{ shelves.map(({ label, reads }) => <section class="garden-section">
				<h2>{label}</h2>
				<div class="shelf-view"><BookShelf {reads} /></div>
				<div class="list-view garden-grid">{reads.map(({ book, finishedOn }) => <BookCard {book} {finishedOn} />)}</div>
			</section>)}
		</div>}
		{(["to-read", "paused", "abandoned"] as const).map(status => {
			const entries = books.filter(book => book.data.status === status);
			return entries.length > 0 && <section class="garden-section"><h2>{bookStatus[status]}</h2><div class="garden-grid">{entries.map(book => <BookCard {book} />)}</div></section>;
		})}
	</GardenLayout>
</Base>

<style>
	.book-browser { display: flex; flex-direction: column; gap: var(--space-8); min-width: 0; }
	.view-options { display: flex; flex-wrap: wrap; gap: var(--space-2); align-self: flex-end; }
	.view-options label { display: inline-flex; align-items: center; gap: var(--space-2); padding: var(--space-2) var(--space-3); min-height: var(--control-size); border: var(--border-width) solid var(--shadow-color); border-radius: var(--radius-card); font: var(--type-label); cursor: pointer; }
	.view-options label:has(:checked) { border-color: var(--accent-color); color: var(--accent-color); }
	input { accent-color: var(--accent-color); }
	.book-browser:not(:has([value="list"]:checked)) .list-view, .book-browser:has([value="list"]:checked) .shelf-view { display: none; }
</style>
