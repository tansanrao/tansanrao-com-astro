---
type RouteItem = {
	path: string;
	extra?: string[];
	label: string;
};

interface Props {
	route: string;
	routes: RouteItem[];
}
const { route, routes } = Astro.props;

/**
 * Check if a route is currently active based on the current route path
 * @param route - The current route path
 * @param home - The home route path
 * @param path - The navigation item path to check against
 * @param extra - Optional array of additional paths that should be considered active
 * @returns True if the route is active, false otherwise
 */
function active(path: string, extra?: string[]) {
	if (extra?.some(item => item === route)) return true;
	if (path === "/") return path === route;
	return route === path || route.startsWith(`${path}/`);
}
---

{routes.map(item => {
	const isActive = active(item.path, item.extra);
	return (
	<a
		href={item.path}
		aria-current={isActive ? "page" : undefined}
		class:list={["nav-link", { active: isActive }]}
	>
		{item.label}
	</a>
	);
})}

<style>
	.nav-link { display: inline-flex; align-items: center; min-height: var(--control-size); padding-inline: var(--space-2); font: var(--type-label); color: var(--secondary-color); overflow-wrap: anywhere; }
	.nav-link.active, .nav-link:hover { color: var(--accent-color); }
</style>
