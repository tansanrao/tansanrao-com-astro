---
import Icon from "$components/Icon.svelte";
import Navigator from "./Navigator.svelte";
import ThemeSwitcher from "./ThemeSwitcher.astro";

const { title } = Astro.props;

/** Define navigation routes configuration */
const routes: { path: string; extra?: string[]; label: string }[] = [
	{ label: "Home", path: "/", extra: ["/news"] },
	{ label: "Blog", path: "/blog" },
	{ label: "Notes", path: "/notes" },
	{ label: "CV", path: "/cv" },
	{ label: "About", path: "/about" }
];

const route = Astro.url.pathname;
---

<style>
	#sidebar {
		transform: translateX(100%);

		&:is([dir="rtl"] *) {
			transform: translateX(-100%);
		}

		&.active {
			transform: translateX(0);
		}
	}

	@media (min-width: 640px) {
		#sidebar {
			transform: none;
		}
	}

	#sidebar-overlay {
		pointer-events: none;
		background-color: transparent;

		&.active {
			pointer-events: auto;
			background-color: var(--overlay-color);
		}
	}
</style>

<header class="site-header sticky top-0 flex items-center justify-between mb-4 bg-background z-100 sm:static sm:pt-3 sm:pb-1 sm:mb-12">
	<a href="/" class="select-text text-lg sm:text-2xl font-bold">{title}</a>

	<button id="sidebar-open" type="button" data-drawer-open="sidebar" aria-controls="sidebar" aria-expanded="false" aria-label="Open Sidebar" class="sm:hidden size-11 items-center justify-center"><Icon name="lucide--align-justify" /></button>
	<div id="sidebar-overlay" data-drawer-overlay="sidebar" aria-hidden="true" class="sm:hidden fixed top-0 inset-s-0 w-screen h-screen transition-[background-color] z-110"></div>

	<nav id="sidebar" data-drawer="sidebar" aria-hidden="true" aria-label="Primary" class="fixed top-0 inset-e-0 w-64 max-w-[85vw] flex flex-col justify-between items-start gap-5 p-5 bg-background h-full sm:static sm:inset-auto sm:w-auto sm:max-w-none sm:ml-auto sm:flex-row sm:items-center sm:justify-end sm:gap-7 sm:p-0 sm:h-auto overflow-y-auto sm:overflow-visible transition-transform z-120">
		<header class="grid gap-5 text-secondary grid-rows-[repeat(5,1fr)] sm:flex sm:items-center sm:justify-end sm:gap-2">
			<button id="sidebar-close" type="button" data-drawer-close="sidebar" aria-label="Close Sidebar" class="sm:hidden size-11 items-center justify-center -m-2 mb-0"><Icon name="lucide--x" /></button>
			<Navigator {route} {routes} client:load />
		</header>

		<footer class="flex flex-col items-start gap-2 sm:flex-row sm:gap-7">
			<ThemeSwitcher />

			<a href="/feed.xml" target="_blank" rel="noopener noreferrer" aria-label="Subscription" class="inline-flex size-11 sm:size-auto items-center justify-center"><Icon name="lucide--rss" /></a>
		</footer>
	</nav>
</header>
