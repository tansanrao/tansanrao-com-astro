---
import Icon from "$components/Icon.astro";
import Navigator from "./Navigator.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";

const { title } = Astro.props;

/** Define navigation routes configuration */
const routes: { path: string; extra?: string[]; label: string }[] = [
	{ label: "Building", path: "/building" },
	{ label: "Writing", path: "/writing" },
	{ label: "Garden", path: "/garden" },
	{ label: "Photography", path: "/photography" },
	{ label: "About", path: "/about" }
];

const route = Astro.url.pathname;
---

<style>
	@reference "../../styles/global.css";

	.site-header {
		display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4); padding-block: var(--space-4); margin-bottom: var(--space-8); background: var(--background-color);
		@variant sm { padding-block: var(--space-6); margin-bottom: var(--space-12); }
	}
	.site-name { font: var(--type-body-strong); }
	#primary-navigation {
		width: 100%; display: flex; flex-direction: column; gap: var(--space-4);
		padding-block: var(--space-4); border-block: var(--border-width) solid var(--shadow-color);
		@variant md { width: auto; margin-inline-start: auto; flex-direction: row; flex-wrap: wrap; align-items: center; gap: var(--space-6); padding: 0; border: 0; }
	}

	.navigation-links {
		display: flex; flex-direction: column; gap: var(--space-2);
		@variant md { flex-direction: row; flex-wrap: wrap; align-items: center; }
	}
	.navigation-actions {
		display: flex; align-items: center; gap: var(--space-2);
		@variant md { border-inline-start: var(--border-width) solid var(--shadow-color); padding-inline-start: var(--space-2); }
	}

	#menu-toggle [data-menu-open] { display: contents; }
	#menu-toggle [data-menu-close],
	#menu-toggle[aria-expanded="true"] [data-menu-open] { display: none; }
	#menu-toggle[aria-expanded="true"] [data-menu-close] { display: contents; }
</style>

<header class="site-header relative z-100">
	<a href="/" aria-current={route === "/" ? "page" : undefined} class="site-name">{title}</a>

	<button id="menu-toggle" type="button" hidden aria-controls="primary-navigation" aria-expanded="false" aria-label="Open menu" class="icon-control">
		<span data-menu-open><Icon name="lucide--align-justify" /></span>
		<span data-menu-close><Icon name="lucide--x" /></span>
	</button>

	<nav id="primary-navigation" aria-label="Primary">
		<div class="navigation-links">
			<Navigator {route} {routes} />
		</div>

		<div class="navigation-actions">
			<ThemeSwitcher />

			<a href="/feed.xml" target="_blank" rel="noopener noreferrer" aria-label="Subscription" class="icon-control"><Icon name="lucide--rss" /></a>
		</div>
	</nav>
</header>

<script>
	const toggle = document.getElementById("menu-toggle")!;
	const navigation = document.getElementById("primary-navigation")!;
	const header = toggle.closest("header")!;
	// Keep this threshold in sync with the shared md breakpoint and navigation styles above.
	const desktop = matchMedia("(min-width: 900px)");

	function setExpanded(expanded: boolean) {
		toggle.setAttribute("aria-expanded", String(expanded));
		toggle.setAttribute("aria-label", expanded ? "Close menu" : "Open menu");
		navigation.hidden = !desktop.matches && !expanded;
	}

	function synchronize() {
		const focusInNavigation = navigation.contains(document.activeElement);
		const focusOnToggle = document.activeElement === toggle;
		toggle.hidden = desktop.matches;
		setExpanded(false);
		if (!desktop.matches && focusInNavigation) toggle.focus();
		if (desktop.matches && focusOnToggle) navigation.querySelector("a")?.focus();
	}

	toggle.addEventListener("click", () => setExpanded(toggle.getAttribute("aria-expanded") !== "true"));
	header.addEventListener("keydown", event => {
		if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
			setExpanded(false);
			toggle.focus();
		}
	});
	navigation.addEventListener("click", event => {
		if (!desktop.matches && event.target instanceof Element && event.target.closest("a")) {
			setExpanded(false);
			toggle.focus();
		}
	});
	desktop.addEventListener("change", synchronize);
	synchronize();
</script>
