---
import config from "$config";
import App from "$layouts/App.astro";
import Header from "$layouts/header/Header.astro";
import Footer from "$layouts/Footer.astro";
import "$styles/global.css";
import "$styles/markdown.css";

const { title: subtitle, description = config.description, article, canonicalURL, noindex = false } = Astro.props;
const title = config.title;
---

<App {title} {subtitle} {description} {article} author={config.author.name} {canonicalURL} {noindex}>
	<div class="site-shell flex flex-col mx-auto">
		<!-- Stretch body to full viewport height to prevent layout jumps from toggleable scrollbars. -->
		<div id="body" class="flex flex-col min-h-screen">
			<Header {title} />
			<slot />
		</div>
		<Footer author={config.author} copyright={config.copyright} />
	</div>
</App>
