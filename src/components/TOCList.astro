---
export interface TOCNode {
	depth: number;
	slug: string;
	text: string;
	children: TOCNode[];
}
interface Props {
	nodes: TOCNode[];
	nested?: boolean;
}
const { nodes, nested = false } = Astro.props;
---

<ul class:list={["toc-list", { "toc-list-nested": nested }]}>
	{
		nodes.map(node => (
			<li id={`indicator-${node.slug}`}>
				<a href={`#${node.slug}`}>
					<span>{node.text}</span>
				</a>
				{node.children.length > 0 && <Astro.self nodes={node.children} nested />}
			</li>
		))
	}
</ul>
