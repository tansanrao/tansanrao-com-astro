---
import Icon from "$components/Icon.astro";

export interface Props {
	toc?: boolean;
	series?: boolean;
	inlineFrom?: "sm" | "reader";
}

const { toc, series, inlineFrom = "sm" } = Astro.props;
---

<style>
	figure {
		inset-inline-end: var(--page-gutter-compact);
	}
	@media (min-width: 640px) {
		figure[data-inline-from="sm"] [data-toc-trigger] {
			display: none;
		}
	}
	@media (min-width: 1100px) {
		figure[data-inline-from="reader"] {
			inset-inline-end: calc(max(var(--page-gutter), (100% - var(--site-width)) / 2) + var(--reading-aside-width) + 2px);
		}
		figure[data-inline-from="reader"] [data-toc-trigger] {
			display: none;
		}
	}

	figure button {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;

		width: 2.75rem;
		height: 2.75rem;

		border-width: 2px;
		border-style: solid;
		border-radius: 50%;

		padding: 5px;
		background-color: var(--background-color);

		box-shadow:
			0 4px 6px -1px rgb(0 0 0 / 0.1),
			0 2px 4px -2px rgb(0 0 0 / 0.1);
	}
</style>

<figure data-position-controls hidden data-inline-from={inlineFrom} class="fixed bottom-15 sm:bottom-30 flex flex-col gap-2 z-100 transition-opacity">
	<button type="button" data-scroll-top aria-label="Scroll to Top" class="border-weak">
		<Icon name="lucide--arrow-up-to-line" size={18} title="To Top" />
		<svg class="absolute -top-0.5 -inset-s-0.5 w-[calc(100%+4px)] h-[calc(100%+4px)] -rotate-90 transform-origin-center pointer-events-none">
			<circle id="progress-circle" cx="50%" cy="50%" r="calc(50% - 1px)" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100"></circle>
		</svg>
	</button>
	{
		(toc || series) && (
			<button type="button" data-drawer-open="toc" aria-controls="toc" aria-expanded="false" aria-label="Open Table of Contents" data-toc-trigger>
				<Icon name="lucide--list" size={15} title="Contents" />
			</button>
		)
	}
</figure>

<script>
	const content = document.getElementById("markdown-content");
	const circle = document.getElementById("progress-circle");
	const controls = document.querySelector<HTMLElement>("[data-position-controls]");
	const warning = content?.closest("details");
	function update() {
		if (!content || !circle || !controls) return;
		controls.hidden = !!warning && !warning.open;
		const contentHeight = content.scrollHeight;
		const contentTop = content.getBoundingClientRect().top + scrollY;
		const scrolled = innerHeight < contentHeight ? Math.max(0, scrollY - contentTop) : scrollY;
		const scrollable = innerHeight < contentHeight ? contentHeight - innerHeight : Math.max(0, contentHeight + contentTop - innerHeight);
		const progress = scrollable > 0 ? Math.min(1, scrolled / scrollable) : 1;
		circle.style.strokeDashoffset = `${100 * (1 - progress)}`;
	}
	document.querySelector("[data-scroll-top]")?.addEventListener("click", () => {
		document.scrollingElement?.scrollTo({ top: 0, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth" });
	});
	window.addEventListener("scroll", update, { passive: true });
	window.addEventListener("resize", update);
	warning?.addEventListener("toggle", update);
	if (content) new ResizeObserver(update).observe(content);
	document.fonts.ready.then(update);
	update();
</script>
