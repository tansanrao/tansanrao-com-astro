---
interface Props {
	sensitive: boolean;
	back: string;
	variant?: "writing";
}
const { sensitive = false, back, variant } = Astro.props;
---

{sensitive ? (
	<details data-content-warning class:list={{ "writing-warning": variant === "writing" }}>
		<summary class="list-none cursor-pointer">
			<div class="flex flex-col items-center justify-end gap-6">
				<h2>Content Warning</h2>
				<div class="flex flex-col items-center justify-end gap-3">
					<p>This content may contain explicit, violent, bloody, or emotionally triggering material.</p>
					<p>If this content might affect your mental health, please leave immediately!</p>
				</div>
				<div class="flex gap-3">
					<span class="flex items-center min-h-11 font-bold text-background bg-error py-1 px-2 rounded-md">I understand, continue reading</span>
					<a href={back} class="flex min-h-11 items-center font-bold text-background bg-secondary py-1 px-2 rounded-md">Return to list</a>
				</div>
			</div>
		</summary>
		<slot />
	</details>
) : <div><slot /></div>}

<style>
	summary::-webkit-details-marker { display: none; }
	details[open] > summary { display: none; }
	.writing-warning > summary { max-width: var(--reading-width); margin-inline: auto; padding: var(--card-padding); border: var(--border-width) solid var(--shadow-color); border-radius: var(--radius-card); background: var(--block-color); font: var(--type-body); }
	.writing-warning > summary > div { align-items: flex-start; gap: var(--space-6); }
	.writing-warning h2 { font: var(--type-section); }
	.writing-warning > summary > div > div { align-items: flex-start; flex-wrap: wrap; gap: var(--space-3); }
	.writing-warning > summary > div > div:last-child > * { font: var(--type-label); min-height: var(--control-size); padding: var(--space-2) var(--space-3); border: var(--border-width) solid var(--accent-color); border-radius: var(--radius-card); color: var(--accent-color); background: var(--background-color); }
</style>

<script>
	document.querySelectorAll<HTMLDetailsElement>("[data-content-warning]").forEach(details => {
		details.addEventListener("toggle", () => {
			if (!details.open) return;
			const content = details.querySelector<HTMLElement>("#markdown-content");
			content?.setAttribute("tabindex", "-1");
			content?.focus({ preventScroll: true });
		});
	});
</script>
