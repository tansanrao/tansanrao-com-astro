---
import type { HTMLAttributes } from "astro/types";
import "medium-zoom/dist/style.css";

interface Props extends HTMLAttributes<"div"> {
	as?: "div" | "section" | "article";
	variant?: "writing" | "garden";
}
const { as: Tag = "div", class: className, variant, ...attributes } = Astro.props;
---

<Tag {...attributes} data-prose class:list={["markdown", className, { "writing-prose": !!variant }]}><slot /></Tag>

<style is:global>
	[data-prose]:not([data-prose-ready]) .code-copy-button { display: none; }

	.writing-prose {
		font: var(--type-body);
		min-width: 0;
		overflow-wrap: anywhere;
		user-select: text;

		/* Section wrappers retain heading anchors and TOC observation without
		   adding a second set of paragraph gaps. */
		& > * + *, section > * + * { margin-block-start: var(--space-4); }
		section[data-heading-rank] { margin-block-start: var(--space-8); }
		& > :first-child { margin-block-start: 0; }
		h1 { font: var(--type-page); }
		h2 { font: var(--type-section); }
		h3 { font: var(--type-item); }
		h4, h5, h6 { font: var(--type-body-strong); }
		:is(h1, h2, h3, h4, h5, h6)[id] { scroll-margin-block-start: var(--space-6); }
		a { color: var(--accent-color); text-decoration: underline; text-underline-offset: var(--link-offset); }
		a:hover { color: var(--primary-color); }
		:is(h1, h2, h3, h4, h5, h6) > a { color: inherit; text-decoration: none; }
		:is(h1, h2, h3, h4, h5, h6) > a:hover { color: var(--accent-color); text-decoration: underline; }
		hr { border-block-start: var(--border-width) solid var(--shadow-color); margin-block: var(--space-8); }
		ul { list-style: disc; }
		ol { list-style: decimal; }
		ul, ol { padding-inline-start: var(--space-6); }
		li + li, li > p + p, li > :is(ul, ol) { margin-block-start: var(--space-2); }
		.contains-task-list { list-style: none; }
		.task-list-item input { accent-color: var(--accent-color); margin-inline-end: var(--space-2); }
		blockquote { border-inline-start: var(--border-width) solid var(--accent-color); padding-inline-start: var(--space-6); color: var(--secondary-color); }
		blockquote > * + * { margin-block-start: var(--space-4); }
		code, pre, kbd { font: var(--type-code); }
		:not(pre) > code, kbd { background: var(--block-color); border-radius: var(--radius-card); padding-inline: var(--space-1); }
		pre { max-width: 100%; overflow-x: auto; padding: var(--space-4); border-radius: var(--radius-card); }
		pre > code { display: block; min-width: max-content; }
		.code-container { display: flex; flex-direction: column; min-width: 0; border: var(--border-width) solid var(--shadow-color); border-radius: var(--radius-card); background: var(--block-color); }
		.code-copy-button { order: -1; display: inline-flex; align-items: center; justify-content: center; align-self: flex-end; width: var(--control-size); height: var(--control-size); margin: var(--space-1); color: var(--secondary-color); }
		.code-copy-button svg { width: var(--icon-size); height: var(--icon-size); }
		.code-copy-button .done-icon, .code-copy-button.code-copied .copy-icon { display: none; }
		.code-copy-button.code-copied .done-icon { display: block; }
		.code-copy-button:hover, .code-copy-button.code-copied { color: var(--accent-color); }
		.code-copy-button.code-copy-failed { color: var(--error-color); }
		figure img { display: block; height: auto; max-width: 100%; }
		figcaption { margin-block-start: var(--space-2); font: var(--type-caption); color: var(--secondary-color); }
		.table-wrapper { max-width: 100%; overflow-x: auto; padding-block-end: var(--space-2); }
		table { width: 100%; border-collapse: collapse; font: var(--type-body); text-align: start; overflow-wrap: normal; }
		th, td { padding: var(--space-3) var(--space-4); border-block-end: var(--border-width) solid var(--shadow-color); vertical-align: top; }
		th { font: var(--type-body-strong); background: var(--block-color); white-space: nowrap; }
		.footnotes { border-block-start: var(--border-width) solid var(--shadow-color); padding-block-start: var(--space-6); margin-block-start: var(--space-8); color: var(--secondary-color); }
		[data-footnote-backref] { display: inline-flex; align-items: center; justify-content: center; min-width: var(--control-size); min-height: var(--control-size); }
		.markdown-alert { border: var(--border-width) solid var(--shadow-color); border-radius: var(--radius-card); padding: var(--card-padding); background: var(--block-color); }
		.markdown-alert > * + * { margin-block-start: var(--space-2); }
		.markdown-alert-title { display: flex; align-items: center; gap: var(--space-2); font: var(--type-body-strong); color: var(--accent-color); }
		.markdown-alert-title svg { width: var(--icon-size); height: var(--icon-size); flex-shrink: 0; }
		.markdown-alert-caution .markdown-alert-title { color: var(--error-color); }
		.markdown-alert-tip .markdown-alert-title { color: var(--success-color); }
		.markdown-alert-important .markdown-alert-title { color: var(--important-color); }
		.markdown-alert-note .markdown-alert-title { color: var(--info-color); }
	}
</style>

<script>
	import mediumZoom from "medium-zoom/dist/pure";

	// Disclosed content is already in the DOM: bind once, including currently hidden prose.
	mediumZoom("[data-prose] img:not([data-nozoom])", { background: "var(--overlay-color)" });
	document.querySelectorAll<HTMLButtonElement>("[data-prose] .code-copy-button").forEach(button => {
		button.addEventListener("click", async () => {
			const code = button.parentElement?.querySelector("pre code")?.textContent;
			if (code === undefined) return;
			button.classList.remove("code-copied", "code-copy-failed");
			try {
				await navigator.clipboard.writeText(code);
				button.classList.add("code-copied");
				button.ariaLabel = button.title = "Copied";
			} catch {
				button.classList.add("code-copy-failed");
				button.ariaLabel = button.title = "Copy failed";
			}
			window.setTimeout(() => {
				button.classList.remove("code-copied", "code-copy-failed");
				button.ariaLabel = button.title = "Copy code";
			}, 1500);
		});
	});
	document.querySelectorAll<HTMLElement>("[data-prose]").forEach(prose => { prose.dataset.proseReady = "true"; });
</script>
