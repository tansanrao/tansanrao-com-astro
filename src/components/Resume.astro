---
import { formatDate, formatDateRange, hasItems, hasText, joinParts, resume } from "$lib/resume";

const sections = [
	{ id: "work", title: "Work", show: hasItems(resume.work) },
	{ id: "education", title: "Education", show: hasItems(resume.education) },
	{ id: "publications", title: "Publications", show: hasItems(resume.publications) },
	{ id: "awards", title: "Awards", show: hasItems(resume.awards) },
	{ id: "certificates", title: "Certificates", show: hasItems(resume.certificates) },
	{ id: "languages", title: "Languages", show: hasItems(resume.languages) },
	{ id: "skills", title: "Skills", show: hasItems(resume.skills) },
	{ id: "projects", title: "Projects", show: hasItems(resume.projects) },
	{ id: "volunteer", title: "Volunteer", show: hasItems(resume.volunteer) },
	{ id: "interests", title: "Interests", show: hasItems(resume.interests) },
	{ id: "references", title: "References", show: hasItems(resume.references) }
].filter(section => section.show);
---

<section class="cv" aria-labelledby="resume-heading">
	<header class="cv-header">
		<h2 id="resume-heading">Curriculum Vitae</h2>
	</header>
	<nav class="cv-nav" aria-label="CV sections">
		{sections.map(section => <a href={`#${section.id}`}>{section.title}</a>)}
	</nav>
	<div class="cv-sections">
		{hasItems(resume.work) && <section class="cv-section" aria-labelledby="work">
			<h3 id="work">Work</h3>
			<div class="cv-list">{resume.work.map(item => <article class="cv-entry">
				<div class="cv-entry-head"><h4>{item.position}</h4>{hasText(formatDateRange(item.startDate, item.endDate)) && <p class="cv-date">{formatDateRange(item.startDate, item.endDate)}</p>}</div>
				{hasText(item.company) && <p>{item.company}</p>}
				{hasText(item.location) && <p class="cv-meta">{item.location}</p>}
				{hasText(item.summary) && <p>{item.summary}</p>}
				{hasItems(item.highlights) && <ul>{item.highlights.map(highlight => <li>{highlight}</li>)}</ul>}
			</article>)}</div>
		</section>}
		{hasItems(resume.education) && <section class="cv-section" aria-labelledby="education">
			<h3 id="education">Education</h3>
			<div class="cv-list">{resume.education.map(item => <article class="cv-entry">
				<div class="cv-entry-head">
					<h4>{hasText(item.url) ? <a href={item.url}>{item.institution}</a> : item.institution}</h4>
					{hasText(formatDateRange(item.startDate, item.endDate)) && <p class="cv-date">{formatDateRange(item.startDate, item.endDate)}</p>}
				</div>
				<p>{joinParts([item.studyType, item.area])}</p>
				{hasText(item.location) && <p class="cv-meta">{item.location}</p>}
				{hasText(item.score) && <p class="cv-meta">Score: {item.score}</p>}
				{hasItems(item.courses) && <p class="cv-meta">Coursework: {item.courses.join("; ")}</p>}
			</article>)}</div>
		</section>}
		{hasItems(resume.publications) && <section class="cv-section" aria-labelledby="publications">
			<h3 id="publications">Publications</h3>
			<div class="cv-list">{resume.publications.map(item => <article class="cv-entry">
				<h4>{hasText(item.url) ? <a href={item.url}>{item.name}</a> : item.name}</h4>
				<p class="cv-meta">{joinParts([item.publisher, formatDate(item.releaseDate || item.date)])}</p>
				{hasText(item.summary) && <p>{item.summary}</p>}
			</article>)}</div>
		</section>}
		{hasItems(resume.awards) && <section class="cv-section" aria-labelledby="awards">
			<h3 id="awards">Awards</h3>
			<div class="cv-list">{resume.awards.map(item => <article class="cv-entry">
				<div class="cv-entry-head"><h4>{item.title}</h4>{hasText(item.date) && <p class="cv-date">{formatDate(item.date)}</p>}</div>
				{hasText(item.awarder) && <p>{item.awarder}</p>}
				{hasText(item.summary) && <p>{item.summary}</p>}
			</article>)}</div>
		</section>}
		{hasItems(resume.certificates) && <section class="cv-section" aria-labelledby="certificates">
			<h3 id="certificates">Certificates</h3>
			<div class="cv-list">{resume.certificates.map(item => <article class="cv-entry">
				<div class="cv-entry-head">
					<h4>{hasText(item.url) ? <a href={item.url}>{item.name}</a> : item.name}</h4>
					{hasText(item.date) && <p class="cv-date">{formatDate(item.date)}</p>}
				</div>
				{hasText(item.issuer) && <p>{item.issuer}</p>}
			</article>)}</div>
		</section>}
		{hasItems(resume.languages) && <section class="cv-section" aria-labelledby="languages">
			<h3 id="languages">Languages</h3>
			<div class="cv-grid">{resume.languages.map(item => <article class="cv-entry">
				<h4>{item.language}</h4>
				{hasText(item.fluency) && <p class="cv-meta">{item.fluency}</p>}
			</article>)}</div>
		</section>}
		{hasItems(resume.skills) && <section class="cv-section" aria-labelledby="skills">
			<h3 id="skills">Skills</h3>
			<div class="cv-list">{resume.skills.map(item => <article class="cv-entry">
				<h4>{item.name}</h4>
				{hasText(item.level) && <p class="cv-meta">{item.level}</p>}
				{hasItems(item.keywords) && <p>{item.keywords.join("; ")}</p>}
			</article>)}</div>
		</section>}
		{hasItems(resume.projects) && <section class="cv-section" aria-labelledby="projects">
			<h3 id="projects">Projects</h3>
			<div class="cv-list">{resume.projects.map(item => <article class="cv-entry">
				<div class="cv-entry-head">
					<h4>{hasText(item.url) ? <a href={item.url}>{item.name}</a> : item.name}</h4>
					{hasText(formatDateRange(item.startDate, item.endDate)) && <p class="cv-date">{formatDateRange(item.startDate, item.endDate)}</p>}
				</div>
				{hasText(joinParts([item.entity, item.type])) && <p class="cv-meta">{joinParts([item.entity, item.type])}</p>}
				{hasText(item.description) && <p>{item.description}</p>}
				{hasItems(item.roles) && <p class="cv-meta">Roles: {item.roles.join("; ")}</p>}
				{hasItems(item.keywords) && <p class="cv-meta">Keywords: {item.keywords.join("; ")}</p>}
				{hasItems(item.highlights) && <ul>{item.highlights.map(highlight => <li>{highlight}</li>)}</ul>}
			</article>)}</div>
		</section>}
		{hasItems(resume.volunteer) && <section class="cv-section" aria-labelledby="volunteer">
			<h3 id="volunteer">Volunteer</h3>
			<div class="cv-list">{resume.volunteer.map(item => <article class="cv-entry">
				<div class="cv-entry-head"><h4>{item.position}</h4>{hasText(formatDateRange(item.startDate, item.endDate)) && <p class="cv-date">{formatDateRange(item.startDate, item.endDate)}</p>}</div>
				{hasText(item.organization) && <p>{item.organization}</p>}
				{hasText(item.summary) && <p>{item.summary}</p>}
				{hasItems(item.highlights) && <ul>{item.highlights.map(highlight => <li>{highlight}</li>)}</ul>}
			</article>)}</div>
		</section>}
		{hasItems(resume.interests) && <section class="cv-section" aria-labelledby="interests">
			<h3 id="interests">Interests</h3>
			<div class="cv-list">{resume.interests.map(item => <article class="cv-entry">
				<h4>{item.name}</h4>
				{hasItems(item.keywords) && <p>{item.keywords.join("; ")}</p>}
			</article>)}</div>
		</section>}
		{hasItems(resume.references) && <section class="cv-section" aria-labelledby="references">
			<h3 id="references">References</h3>
			<div class="cv-list">{resume.references.map(item => <article class="cv-entry">
				<h4>{item.name}</h4>
				{hasText(item.reference) && <p>{item.reference}</p>}
			</article>)}</div>
		</section>}
	</div>
</section>

<style>
	@reference "../styles/global.css";
	.cv { display: flex; flex-direction: column; gap: var(--space-8); min-width: 0; font: var(--type-body); overflow-wrap: anywhere; }
	.cv-header { border-block-start: var(--border-width) solid var(--shadow-color); padding-block-start: var(--section-gap); }
	.cv-header h2 { font: var(--type-section); }
	.cv-nav { display: flex; flex-wrap: wrap; gap: 0 var(--space-6); border-block-end: var(--border-width) solid var(--shadow-color); font: var(--type-label); }
	.cv-nav a { display: inline-flex; align-items: center; min-height: var(--control-size); padding-block: var(--space-3); color: var(--secondary-color); text-decoration: none; border-block-end: var(--border-width) solid transparent; }
	.cv-nav a:hover, .cv-nav a:focus-visible { color: var(--accent-color); border-color: var(--accent-color); }
	a { color: var(--accent-color); text-decoration: underline; text-underline-offset: var(--link-offset); }
	a:hover { color: var(--primary-color); }
	.cv-sections { display: flex; flex-direction: column; gap: var(--section-gap); }
	.cv-section { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6); border-block-start: var(--border-width) solid var(--shadow-color); padding-block-start: var(--space-6); }
	.cv-section:first-child { border-block-start: 0; padding-block-start: 0; }
	.cv-section {
		@variant md { grid-template-columns: var(--label-width) minmax(0, 1fr); gap: var(--reading-gap); }
	}
	.cv-section > h3 { font: var(--type-section); }
	[id] { scroll-margin-block-start: var(--space-6); }
	.cv-list { display: flex; flex-direction: column; gap: var(--space-8); min-width: 0; }
	.cv-entry { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
	.cv-entry h4 { font: var(--type-item); }
	.cv-entry-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-6); }
	.cv-entry-head h4 { flex: 1 1 var(--card-min-width); }
	.cv-meta, .cv-date { font: var(--type-meta); color: var(--secondary-color); }
	.cv-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--card-min-width)), 1fr)); gap: var(--space-8) var(--grid-gap); }
	ul { list-style: disc; padding-inline-start: var(--space-6); }
	li + li { margin-block-start: var(--space-2); }
	@media print {
		:global(.site-header), :global(.site-footer), .cv-nav { display: none !important; }
		.cv-entry { break-inside: avoid; }
		.cv-section > h3, .cv-header { break-after: avoid; }
		.cv-section { display: block; }
		.cv-section > h3 { margin-block-end: var(--space-6); }
	}
</style>
