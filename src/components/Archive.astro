---
import Icon from "./Icon.astro";
import Pagination from "./Pagination.astro";
import Time from "$lib/time";

interface Props {
	kind: "writing" | "notes";
	size: number;
	entries: {
		id: string;
		url: string;
		data: { title: string; publishedAt: Date; series?: string; tags?: string[]; sensitive: boolean; top: number };
	}[];
	series?: string[];
	tags: string[];
}

const { kind, size, entries, series = [], tags } = Astro.props;
const sorted = [...entries].sort((a, b) => b.data.top - a.data.top || b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<archive-list data-kind={kind} data-size={size} class={kind === "writing" ? "writing-archive" : "flex flex-col-reverse sm:flex-row gap-10 grow"}>
	{kind === "writing" && <details data-filters hidden class="writing-filters">
		<summary>Filter writing <Icon name="lucide--chevron-down" /></summary>
		<div class="filter-groups">
			{series.length > 0 && <section aria-labelledby="writing-series"><h2 id="writing-series">Series</h2><div class="filter-options">{series.map(item => <button type="button" data-series-toggle={item} aria-pressed="false">{item}</button>)}</div></section>}
			{tags.length > 0 && <section aria-labelledby="writing-tags"><h2 id="writing-tags">Tags</h2><p class="filter-help">Match all selected tags.</p><div class="filter-options">{tags.map(tag => <button type="button" data-tag-toggle={tag} aria-pressed="false">{tag}</button>)}</div></section>}
		</div>
	</details>}
	<div class={kind === "writing" ? "archive-results" : "flex flex-col grow"}>
		{kind === "writing" && <button type="button" data-clear-filters hidden>Clear filters <Icon name="lucide--x" /></button>}
		<div class={kind === "writing" ? "writing-entries" : "grid grid-cols-[repeat(auto-fill,minmax(250px,1fr))] gap-5"}>
			{sorted.map(entry => (
				<section data-entry data-tags={JSON.stringify(entry.data.tags ?? [])} data-series={entry.data.series} class={kind === "writing" ? "writing-entry" : "flex flex-col justify-center border-b border-dashed border-b-weak pb-1"}>
					{kind === "writing" ? (
						<>
							<time datetime={entry.data.publishedAt.toISOString()} title={Time.toString(entry.data.publishedAt)}>{Time.toLocaleDateString(entry.data.publishedAt, "en-US")}</time>
							<div class="entry-copy">
								<h2><a href={entry.url} class="entry-title">{entry.data.title}<Icon name="lucide--arrow-right" /></a></h2>
								<div class="entry-context">
									{entry.data.top > 0 && <span><Icon name="lucide--flag-triangle-right" /> Pinned</span>}
									{entry.data.sensitive && <span><Icon name="lucide--siren" /> Sensitive content</span>}
									{entry.data.series && <a href={`?series=${encodeURIComponent(entry.data.series)}`} data-series-select={entry.data.series}>{entry.data.series}</a>}
									{entry.data.tags?.map(tag => <a href={`?tag=${encodeURIComponent(tag)}`} data-tag-select={tag}>#{tag}</a>)}
								</div>
							</div>
						</>
					) : (
						<>
							<span class="flex items-center gap-1">
								{entry.data.top > 0 && <Icon name="lucide--flag-triangle-right" class="rtl:-scale-x-100" />}
								{entry.data.sensitive && <Icon name="lucide--siren" title="Contains sensitive content" />}
								<a href={entry.url} class="leading-normal text-primary font-semibold link truncate">{entry.data.title}</a>
							</span>
							<span class="flex gap-1">
								{entry.data.tags?.map(tag => <a href={`?tag=${encodeURIComponent(tag)}`} data-tag-select={tag} class="max-sm:min-h-8 text-[0.825rem] text-remark">#{tag}</a>)}
							</span>
						</>
					)}
				</section>
			))}
			<div data-empty hidden={sorted.length > 0} class={kind === "writing" ? "writing-empty" : "pt-[10vh] text-center text-secondary font-bold text-xl"}>{kind === "writing" ? "No posts to show. Try clearing your filters or check back for new writing." : "No notes available"}</div>
		</div>
		<Pagination pages={Math.ceil(sorted.length / size)} {kind} />
		<p data-status role="status" class="sr-only"></p>
		<noscript><p class={kind === "writing" ? "filter-help" : "text-sm text-secondary"}>Showing all entries. Filtering and pagination require JavaScript.</p></noscript>
	</div>
	{kind === "notes" && <aside data-filters hidden class="sm:basis-50 shrink-0 flex flex-col gap-5">
		<section><h4>Tag</h4><p>{tags.map(tag => <button type="button" data-tag-toggle={tag} aria-pressed="false">{tag}</button>)}</p></section>
	</aside>}
</archive-list>

<style>
	@reference "../styles/global.css";

	.writing-archive { display: flex; flex-direction: column; gap: var(--space-8); min-width: 0; overflow-wrap: anywhere;
		@variant md { flex-direction: row-reverse; flex-wrap: wrap; gap: var(--space-12); align-items: flex-start; }
	}
	.archive-results { display: flex; flex-direction: column; gap: var(--space-4); min-width: 0;
		@variant md { flex: 2 1 60%; }
	}
	[data-clear-filters] { display: inline-flex; align-self: flex-end; align-items: center; gap: var(--space-2); min-height: var(--control-size); font: var(--type-label); color: var(--accent-color); text-decoration: underline; text-underline-offset: var(--link-offset); }
	.writing-entries { border-top: var(--border-width) solid var(--shadow-color); }
	.writing-entry { display: flex; flex-direction: column; gap: var(--space-2) var(--grid-gap); padding-block: var(--row-padding); border-bottom: var(--border-width) solid var(--shadow-color);
		@variant sm { flex-direction: row; flex-wrap: wrap; align-items: baseline; }
	}
	.writing-entry time { font: var(--type-meta); color: var(--secondary-color);
		@variant sm { flex: 0 1 var(--label-width); }
	}
	.entry-copy { min-width: 0;
		@variant sm { flex: 1 1 var(--card-min-width); }
	}
	.entry-copy h2 { font: var(--type-item); }
	.entry-title { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); min-height: var(--control-size); }
	.entry-title :global(figure) { flex-shrink: 0; align-self: center; color: var(--secondary-color); }
	.entry-title:hover { color: var(--accent-color); }
	.entry-context { display: flex; flex-wrap: wrap; align-items: center; gap: 0 var(--space-3); font: var(--type-meta); color: var(--secondary-color); }
	.entry-context > span, .entry-context > a { display: inline-flex; align-items: center; gap: var(--space-2); min-height: var(--control-size); }
	.entry-context [data-series-select], .entry-context a:hover { color: var(--accent-color); text-decoration: underline; text-underline-offset: var(--link-offset); }
	.writing-empty { padding-block: var(--space-8); font: var(--type-body); color: var(--secondary-color); }
	.writing-filters { min-width: 0; border-block: var(--border-width) solid var(--shadow-color);
		@variant md { flex: 1 1 var(--reading-aside-width); }
	}
	.writing-filters summary { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); min-height: var(--control-size); padding-block: var(--space-2); font: var(--type-label); cursor: pointer; list-style: none; }
	.writing-filters summary::-webkit-details-marker { display: none; }
	.writing-filters[open] summary :global(figure) { transform: rotate(180deg); }
	.filter-groups { display: flex; flex-direction: column; gap: var(--space-6); padding-block: var(--space-4) var(--space-6); }
	.filter-groups section { display: flex; flex-direction: column; gap: var(--space-2); }
	.filter-groups h2 { font: var(--type-item); }
	.filter-help { font: var(--type-meta); color: var(--secondary-color); }
	.filter-options { display: flex; flex-wrap: wrap; gap: var(--space-2); }
	.filter-options button { display: inline-flex; align-items: center; min-height: var(--control-size); max-width: 100%; padding: var(--space-2) var(--space-3); border: var(--border-width) solid var(--shadow-color); border-radius: var(--radius-card); font: var(--type-label); color: var(--secondary-color); text-align: start; overflow-wrap: anywhere; }
	.filter-options button:hover, .filter-options button[aria-pressed="true"] { border-color: var(--accent-color); color: var(--accent-color); }
	.filter-options button[aria-pressed="true"] { color: var(--primary-color); background: var(--selection-color); }

	aside section {
		display: flex;
		flex-direction: column;
		gap: 5px;
	}
	aside p {
		display: flex;
		flex-wrap: wrap;
		gap: 5px;
	}
	aside button {
		border-bottom: 1px solid var(--primary-color);
		padding: 0 0.35rem;
		font-size: 0.9rem;
		transition: color 0.1s ease-in-out, background-color 0.1s ease-in-out;
	}
	aside button[aria-pressed="true"] {
		color: var(--background-color);
		background-color: var(--accent-color);
		border-color: var(--accent-color);
	}
	@media (max-width: 639px) {
		aside button { min-height: 2.25rem; padding-inline: 0.5rem; }
	}
	@media (min-width: 640px) {
		aside button:hover { color: var(--background-color); background-color: var(--accent-color); border-color: var(--accent-color); }
	}
</style>

<script>
	class ArchiveList extends HTMLElement {
		connectedCallback() {
			const size = Number(this.dataset.size);
			const writing = this.dataset.kind === "writing";
			const entries = Array.from(this.querySelectorAll<HTMLElement>("[data-entry]")).map(element => ({
				element, tags: JSON.parse(element.dataset.tags!) as string[], series: element.dataset.series
			}));
			const url = new URL(location.href);
			let pageParam = url.searchParams.has("page");
			let page = Number(url.searchParams.get("page")) || 1;
			let tags = url.searchParams.getAll("tag");
			let series = writing ? url.searchParams.get("series") : null;
			const filters = this.querySelector<HTMLDetailsElement>("details[data-filters]");
			if (filters) filters.open = matchMedia("(min-width: 900px)").matches;
			const render = () => {
				const matching = entries.filter(entry => (!series || entry.series === series) && tags.every(tag => entry.tags.includes(tag)));
				const pages = Math.ceil(matching.length / size);
				page = Math.max(1, Math.min(Math.floor(page), pages));
				const visible = new Set(matching.slice((page - 1) * size, page * size));
				for (const entry of entries) entry.element.hidden = !visible.has(entry);
				this.querySelector<HTMLElement>("[data-empty]")!.hidden = matching.length > 0;
				this.querySelector<HTMLElement>("[data-filters]")!.hidden = false;
				this.querySelector<HTMLElement>("[data-pagination]")!.hidden = pages <= 1;
				this.querySelectorAll<HTMLButtonElement>("[data-tag-toggle], [data-series-toggle]").forEach(button => {
					button.setAttribute("aria-pressed", String(button.dataset.tagToggle !== undefined ? tags.includes(button.dataset.tagToggle) : series === button.dataset.seriesToggle));
				});
				this.querySelectorAll<HTMLButtonElement>("[data-page]").forEach(button => {
					const value = button.dataset.page!;
					const number = Number(value);
					if (value === "previous" || value === "next") {
						button.disabled = value === "previous" ? page <= 1 : page >= pages;
					} else {
						const start = Math.max(2, Math.min(pages - 5, page - 2));
						button.hidden = number > pages || !(number === 1 || number === pages || (number >= start && number < start + 5));
						if (number === page) button.setAttribute("aria-current", "page");
						else button.removeAttribute("aria-current");
					}
				});
				this.querySelector<HTMLElement>("[data-ellipsis-start]")!.hidden = !(pages > 7 && page > 4);
				this.querySelector<HTMLElement>("[data-ellipsis-end]")!.hidden = !(pages > 7 && page < pages - 3);
				// Move the trailing ellipsis before the current last page, without rebuilding buttons or losing focus.
				const last = this.querySelector(`[data-page="${pages}"]`);
				if (last) last.before(this.querySelector("[data-ellipsis-end]")!);
				this.querySelector<HTMLElement>("[data-status]")!.textContent = `${matching.length} ${writing ? "posts" : "notes"}. Page ${page} of ${Math.max(1, pages)}.`;
				const clear = this.querySelector<HTMLElement>("[data-clear-filters]");
				if (clear) clear.hidden = tags.length === 0 && !series;
				const url = new URL(location.href);
				url.searchParams.delete("tag");
				url.searchParams.delete("page");
				if (writing) { url.searchParams.delete("series"); if (series) url.searchParams.set("series", series); }
				for (const tag of tags) url.searchParams.append("tag", tag);
				if (pageParam) url.searchParams.set("page", String(page));
				history.replaceState(history.state, "", url);
			};
			this.addEventListener("click", event => {
				if (!(event.target instanceof Element) || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
				const control = event.target.closest<HTMLElement>("[data-tag-toggle], [data-tag-select], [data-series-toggle], [data-series-select], [data-page], [data-clear-filters]");
				if (!control) return;
				event.preventDefault();
				const data = control.dataset;
				if (data.clearFilters !== undefined) {
					tags = [];
					series = null;
					page = 1;
					pageParam = false;
					// Keep focus visible when the clear button disappears.
					filters?.querySelector("summary")?.focus();
				} else if (data.page) {
					page = data.page === "next" ? page + 1 : data.page === "previous" ? page - 1 : Number(data.page);
					pageParam = true;
				} else {
					const tag = data.tagToggle ?? data.tagSelect;
					const choice = data.seriesToggle ?? data.seriesSelect;
					if (tag !== undefined) tags = data.tagToggle !== undefined && tags.includes(tag) ? tags.filter(item => item !== tag) : [...new Set([...tags, tag])];
					if (choice !== undefined) series = data.seriesToggle !== undefined && series === choice ? null : choice;
					page = 1;
					pageParam = false;
				}
				render();
			});
			// Enhanced in-place selectors use button semantics; their hrefs remain useful before enhancement.
			this.querySelectorAll<HTMLAnchorElement>("[data-tag-select], [data-series-select]").forEach(link => {
				link.setAttribute("role", "button");
				link.addEventListener("keydown", event => { if (event.key === " ") { event.preventDefault(); link.click(); } });
			});
			render();
		}
	}
	customElements.define("archive-list", ArchiveList);
</script>
