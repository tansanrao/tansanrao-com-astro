---
import { Temporal } from "temporal-polyfill";
import config from "$config";
import type { Section } from "$lib/config";
import { blogEntryPath } from "$lib/paths";
import Time from "$lib/time";

/**
 * Content item structure
 */
interface ContentItem {
	id: string;
	data: {
		title: string;
		timestamp: Date;
	};
}

/**
 * Heatmap component props
 */
interface Props {
	blogEntries: ContentItem[];
	notes: ContentItem[];
}

let { blogEntries, notes } = Astro.props;

// Temporary storage for processed content and heatmap cells
const contents: { section: Section; title: string; date: Temporal.PlainDate; link: string }[] = [];
const cells: { target: string; contents: typeof contents }[] = [];

// Determine heatmap frequency (default: day)
const frequency = config.heatmap?.unit || "day";
const now = Time().toPlainDate();

// Normalize blog entries and add to contents list
blogEntries.forEach(entry => {
	contents.push({
		section: "blog",
		title: entry.data.title,
		date: Time(entry.data.timestamp.toISOString()).toPlainDate(),
		link: blogEntryPath(entry)
	});
});

// Normalize notes and add to contents list
notes.forEach(entry => {
	contents.push({
		section: "notes",
		title: entry.data.title,
		date: Time(entry.data.timestamp.toISOString()).toPlainDate(),
		link: `/notes/${entry.id}`
	});
});

// Group content into heatmap cells based on the configured frequency
if (frequency === "month") {
	const { years = 4 } = config.heatmap?.unit === "month" ? config.heatmap : {};
	const start = Temporal.PlainDate.from({ year: now.year - years + 1, month: 1, day: 1 });
	const end = Temporal.PlainDate.from({ year: now.year, month: 12, day: 31 });

	let current = start;
	// Initialize month-based cells
	while (Temporal.PlainDate.compare(current, end) <= 0) {
		cells.push({
			target: current.toLocaleString("en", { month: "short", year: "numeric" }),
			contents: []
		});
		current = current.add({ months: 1 });
	}

	// Distribute content into month-based cells
	contents.forEach(content => {
		const gap = start.until(content.date, { largestUnit: "month" }).months;
		if (gap >= 0 && gap < cells.length) cells[gap].contents.push(content);
	});
} else if (frequency === "week") {
	const start = now.subtract({ weeks: 51, days: now.dayOfWeek - 1 });

	let current = start;
	// Initialize week-based cells
	while (Temporal.PlainDate.compare(current, now) <= 0) {
		cells.push({
			target: `${current.toLocaleString("en", { month: "short", day: "numeric" })} - ${current.add({ days: 6 }).toLocaleString("en", { month: "short", day: "numeric" })}`,
			contents: []
		});
		current = current.add({ weeks: 1 });
	}

	// Distribute content into week-based cells
	contents.forEach(content => {
		const gap = start.until(content.date, { largestUnit: "week" }).weeks;
		if (gap >= 0 && gap < cells.length) cells[gap].contents.push(content);
	});
} else {
	const weekend = now.add({ days: 7 - now.dayOfWeek });

	const { weeks = 20 } = config.heatmap?.unit === "day" ? config.heatmap : {};
	const start = weekend.subtract({ weeks: weeks - 1, days: 6 });

	let current = start;
	// Initialize day-based cells
	while (Temporal.PlainDate.compare(current, weekend) <= 0) {
		cells.push({ target: current.toLocaleString("en", { dateStyle: "medium" }), contents: [] });
		current = current.add({ days: 1 });
	}

	// Distribute content into day-based cells
	contents.forEach(content => {
		const gap = start.until(content.date, { largestUnit: "day" }).days;
		if (gap >= 0 && gap < cells.length) cells[gap].contents.push(content);
	});
}
---

<section class:list={["grid gap-1", { "grid-flow-col grid-rows-7": frequency === "day", "grid-cols-13": frequency === "week", "grid-cols-12": frequency === "month" }]}>
	{
		cells.map((cell, index) => {
			const count = cell.contents.length;
			const details = [];
			const detailId = `heatmap-details-${index}`;
			const countLabel = `${count} ${count === 1 ? "entry" : "entries"}`;

			// Generate details for the popup based on cell content
			if (count) {
				const blogEntries = cell.contents.filter(content => content.section === "blog");
				const notes = cell.contents.filter(content => content.section === "notes");

				if (blogEntries.length) {
					if (frequency === "month") {
						details.push(<p>{blogEntries.length} {blogEntries.length === 1 ? "blog post" : "blog posts"}</p>);
					} else {
						details.push(
							<p class="my-1">{blogEntries.length} {blogEntries.length === 1 ? "blog post" : "blog posts"}:</p>,
							<ul class="flex flex-col gap-0.5">
								{blogEntries.map(entry => (
									<li>
										<a href={entry.link} aria-label={entry.title} class="ms-1 link">
											{entry.title}
										</a>
									</li>
								))}
							</ul>
						);
					}
				}

				if (notes.length) {
					if (frequency === "month") {
						details.push(<p>{notes.length} {notes.length === 1 ? "note" : "notes"}</p>);
					} else {
						details.push(
							<p class="my-1">{notes.length} {notes.length === 1 ? "note" : "notes"}:</p>,
							<ul class="flex flex-col gap-0.5">
								{notes.map(entry => (
									<li>
										<a href={entry.link} aria-label={entry.title} class="ms-1 link">
											{entry.title}
										</a>
									</li>
								))}
							</ul>
						);
					}
				}
			} else {
				// Display empty message if no content
				details.push(<p class="mt-1">No words</p>);
			}

			return (
				<figure class="group/pop" data-heatmap>
					{count > 0 ? (
						<button
							type="button"
							data-heatmap-trigger
							aria-label={`${cell.target}: ${countLabel}`}
							aria-controls={detailId}
							aria-expanded="false"
							class="heatmap-cell-trigger"
						>
							<i class:list={["block bg-primary/10", { "w-2.5 h-2.5": frequency === "day", "w-4 h-4": frequency === "week", "w-4.5 h-4.5": frequency === "month" }, { "bg-primary/40": count > 0, "bg-primary/70": count > 1, "bg-primary": count > 2 }]} />
						</button>
					) : (
						<i class:list={["block bg-primary/10", { "w-2.5 h-2.5": frequency === "day", "w-4 h-4": frequency === "week", "w-4.5 h-4.5": frequency === "month" }]} />
					)}

					<div id={detailId} class="w-max max-w-[min(18rem,85vw)] flex flex-col mb-1 rounded-sm px-2 py-2 text-xs text-background bg-primary pop">
						<time class="font-bold">{cell.target}</time>
						{details}
					</div>
				</figure>
			);
		})
	}
</section>

<style>
	figure.is-open .pop,
	figure:focus-within .pop {
		opacity: 1;
		visibility: visible;
	}

	.heatmap-cell-trigger {
		position: relative;
		padding: 0;
	}

	@media (max-width: 639px), (hover: none), (pointer: coarse) {
		.heatmap-cell-trigger::before {
			position: absolute;
			inset: -4px;
			content: "";
		}
	}

	@supports (anchor-name: --anchor-heatmap) {
		figure {
			anchor-scope: --anchor-heatmap;

			i {
				anchor-name: --anchor-heatmap;
			}

			.pop {
				position: fixed;
				position-anchor: --anchor-heatmap;
				position-area: top;
				justify-self: anchor-center;
				z-index: 10;
			}
		}
	}

	@supports not (anchor-name: --anchor-heatmap) {
		figure {
			position: relative;

			.pop {
				position: absolute;
				bottom: 100%;
				inset-inline-start: 0;
				transform: translateX(-50%);
			}
		}

		figure .pop:dir(rtl) {
			transform: translateX(50%);
		}
	}
</style>
