---
import { markdownAlertIcon, type MarkdownAlertType } from "$lib/markdown/plugins";

interface Props {
	type?: MarkdownAlertType;
	title?: string;
}

const { type = "note", title = type.charAt(0).toUpperCase() + type.slice(1) } = Astro.props;
---

<div class:list={["markdown-alert", `markdown-alert-${type}`]}>
	<p class="markdown-alert-title">
		<Fragment set:html={markdownAlertIcon(type)} />
		<strong>{title}</strong>
	</p>
	<slot />
</div>
