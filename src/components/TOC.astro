---
import type { MarkdownHeading } from "astro";
import Icon from "$components/Icon.astro";
import TOCList, { type TOCNode } from "$components/TOCList.astro";

interface Props {
	headings?: MarkdownHeading[];
	series?: { title: string; url: string; current: boolean }[];
	inlineFrom?: "sm" | "reader";
}

const { headings, series, inlineFrom = "sm" } = Astro.props;
const nodes: TOCNode[] = [];
const stack: TOCNode[] = [];
for (const heading of headings ?? []) {
	const node = { ...heading, children: [] };
	while (stack.length && stack[stack.length - 1].depth >= node.depth) stack.pop();
	const parent = stack[stack.length - 1];
	(parent ? parent.children : nodes).push(node);
	stack.push(node);
}
---

<style is:global>
	#toc {
		--toc-link-min-height: 44px;
		position: fixed;
		inset-block-start: 0;
		inset-inline-end: 0;
		z-index: 120;
		display: flex;
		flex-direction: column;
		gap: 16px;
		width: min(384px, calc(100vw - 32px));
		height: 100dvh;
		padding: max(24px, env(safe-area-inset-top)) max(24px, env(safe-area-inset-right)) max(24px, env(safe-area-inset-bottom)) max(24px, env(safe-area-inset-left));
		background: var(--background-color);
		visibility: hidden;
		transform: translateX(100%);
		transition:
			transform 180ms ease,
			visibility 180ms;
	}
	[dir="rtl"] #toc {
		transform: translateX(-100%);
	}
	#toc.active {
		transform: translateX(0);
		visibility: visible;
	}
	#toc-close {
		width: 44px;
		height: 44px;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
	}
	.toc-scroll {
		min-height: 0;
		width: 100%;
		overflow-y: auto;
		overscroll-behavior: contain;
		display: flex;
		flex-direction: column;
		gap: 28px;
		padding: 4px;
	}
	#toc h4 {
		margin-bottom: 12px;
	}
	#toc .toc-list {
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: 16px;
		line-height: 1.5;
	}
	#toc .toc-list > li + li {
		margin-top: 12px;
	}
	#toc .toc-list-nested {
		padding-inline-start: 16px;
		margin-top: 4px;
	}
	#toc .toc-list-nested > li + li {
		margin-top: 4px;
	}
	#toc .toc-list a {
		display: grid;
		grid-template-columns: 8px minmax(0, 1fr);
		align-content: center;
		gap: 8px;
		min-height: var(--toc-link-min-height);
		padding-block: 2px;
		color: var(--secondary-color);
		font-weight: 600;
		transition: color 150ms;
	}
	#toc .toc-list a::before {
		content: "•";
		color: var(--remark-color);
	}
	#toc .toc-list a > span {
		min-width: 0;
		overflow-wrap: anywhere;
		white-space: normal;
	}
	#toc .toc-list-nested a,
	#toc .toc-series a {
		font-weight: 400;
	}
	#toc .toc-list-nested a::before {
		content: "–";
	}
	#toc .toc-list a:hover,
	#toc .indicate > a,
	#toc a[aria-current] {
		color: var(--primary-color);
	}
	#toc .indicate > a::before,
	#toc a[aria-current]::before {
		content: "▸";
		color: var(--primary-color);
	}
	#toc-overlay {
		position: fixed;
		inset: 0;
		z-index: 110;
		pointer-events: none;
		background: transparent;
		transition: background-color 180ms;
	}
	#toc-overlay.active {
		pointer-events: auto;
		background: var(--overlay-color);
	}
	@media (min-width: 640px) {
		#toc[data-drawer-inline-from="sm"] {
			--toc-link-min-height: 0px;
			position: sticky;
			inset-block-start: var(--sticky-inset);
			inset-inline-end: auto;
			align-self: flex-start;
			width: 200px;
			flex: 0 0 200px;
			height: auto;
			max-height: calc(100dvh - 2 * var(--sticky-inset));
			padding: 0;
			visibility: visible;
			transform: none;
			z-index: auto;
		}
		#toc[data-drawer-inline-from="sm"] #toc-close,
		#toc-overlay[data-inline-from="sm"] {
			display: none;
		}
	}
	@media (min-width: 1100px) {
		#toc[data-drawer-inline-from="reader"] {
			--toc-link-min-height: 0px;
			position: sticky;
			inset-block-start: var(--sticky-inset);
			inset-inline-end: auto;
			align-self: start;
			width: var(--reading-aside-width);
			height: auto;
			max-height: calc(100dvh - 2 * var(--sticky-inset));
			padding: 0;
			visibility: visible;
			transform: none;
			z-index: auto;
		}
		#toc[data-drawer-inline-from="reader"] #toc-close,
		#toc-overlay[data-inline-from="reader"] {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		#toc,
		#toc-overlay {
			transition: none;
		}
	}
</style>

<div id="toc-overlay" data-drawer-overlay="toc" aria-hidden="true" data-inline-from={inlineFrom}></div>
<aside id="toc" data-drawer="toc" data-drawer-inline-from={inlineFrom} aria-hidden="true" aria-label="Page navigation" inert>
	<button id="toc-close" type="button" data-drawer-close="toc" aria-label="Close Table of Contents">
		<Icon name="lucide--x" />
	</button>
	<div class="toc-scroll">
		{
			nodes.length > 0 && (
				<section>
					<h4 id="toc-heading">Contents</h4>
					<nav aria-labelledby="toc-heading">
						<TOCList {nodes} />
					</nav>
				</section>
			)
		}
		{
			series && series.length > 0 && (
				<section>
					<h4 id="series-heading">Series</h4>
					<nav aria-labelledby="series-heading">
						<ul class="toc-list toc-series">
							{series.map(item => (
								<li>
									<a href={item.url} aria-current={item.current ? "page" : undefined}>
										<span>{item.title}</span>
									</a>
								</li>
							))}
						</ul>
					</nav>
				</section>
			)
		}
	</div>
</aside>
