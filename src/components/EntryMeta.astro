---
import Time from "$lib/time";
import Icon from "$components/Icon.astro";

export interface Props {
	publishedAt: Date;
	updatedAt?: Date;
	series?: string;
	tags?: string[];
	words: number;
}

const { publishedAt, updatedAt, series, tags, words } = Astro.props;
---

<time datetime={publishedAt.toISOString()} title={Time.toString(publishedAt)}><Icon name="lucide--calendar" />{Time.toString(publishedAt)}</time>
{
	updatedAt && (
		<time datetime={updatedAt.toISOString()} title={Time.toString(updatedAt)}>
			<Icon name="lucide--refresh-cw" />
			Updated {Time.toString(updatedAt)}
		</time>
	)
}
{
	series && (
		<span>
			<Icon name="lucide--layers" />
			{series}
		</span>
	)
}
{
	!!tags?.length && (
		<span>
			<Icon name="lucide--hash" />
			{tags?.join("; ")}
		</span>
	)
}
<span><Icon name="lucide--pilcrow" />{words} {words === 1 ? "word" : "words"}</span>
