{
	"name": "tansanrao-com-astro",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"remoteUser": "node",
	"forwardPorts": [4321],
	"portsAttributes": {
		"4321": {
			"label": "Astro dev server",
			"onAutoForward": "notify"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"astro-build.astro-vscode",
				"bradlc.vscode-tailwindcss",
				"svelte.svelte-vscode",
				"unifiedjs.vscode-mdx",
				"yzhang.markdown-all-in-one",
				"biomejs.biome"
			]
		}
	},
	"postCreateCommand": "corepack enable && corepack prepare pnpm@10.32.1 --activate && corepack pnpm install"
}
